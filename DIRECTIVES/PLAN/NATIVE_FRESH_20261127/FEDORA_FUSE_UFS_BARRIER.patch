+	}
+
diff --git a/rufs/src/ufs/mod.rs b/rufs/src/ufs/mod.rs
index 3909303..23b5978 100644
--- a/rufs/src/ufs/mod.rs
+++ b/rufs/src/ufs/mod.rs
@@ -87,0 +88,5 @@ impl Ufs<File> {
+	/// Flush this filesystem and request a durable barrier on its backing file.
+	pub fn sync_all(&mut self) -> IoResult<()> {
+		self.file.inner_mut().sync_all()
+	}
+
