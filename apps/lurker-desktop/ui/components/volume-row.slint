// VolumeRow — mounted-volume card with inline unmount action (views.jsx:572-640)

import { UiTheme } from "../theme.slint";
import { PillSurface } from "primitives.slint";
import { ActionButton } from "inputs.slint";

export struct VolumeRowData {
    name: string,
    source: string,
    mount: string,
    readonly: bool,
    cipher: string,
    source-kind: string,
    unprivileged: bool,
}

export component VolumeRow inherits Rectangle {
    in property <VolumeRowData> data;
    in-out property <bool> expanded: false;
    in property <bool> enabled: true;

    callback clicked;
    callback unmount-clicked;

    min-height: 54px * UiTheme.scale;
    border-width: 0.5px * UiTheme.scale;
    border-color: root.expanded ? UiTheme.accent : UiTheme.line-strong;
    border-radius: UiTheme.radius;
    background: root.expanded
        ? UiTheme.accent-soft
        : (t.has-hover ? UiTheme.bg-2 : UiTheme.bg-0);

    VerticalLayout {
        spacing: 0;

        // ── Top row — always visible (54px tall)
        HorizontalLayout {
            padding-left: 14px * UiTheme.scale;
            padding-right: 14px * UiTheme.scale;
            padding-top: 12px * UiTheme.scale;
            padding-bottom: 12px * UiTheme.scale;
            spacing: 14px * UiTheme.scale;
            alignment: start;

            // Icon tile (accent-soft 32×32 with LockOpen)
            icon-tile := Rectangle {
                width: 32px * UiTheme.scale;
                height: 32px * UiTheme.scale;
                border-radius: 8px * UiTheme.scale;
                background: UiTheme.accent-soft;
                Image {
                    source: @image-url("../icons/lock-open.svg");
                    width: 14px * UiTheme.scale;
                    height: 14px * UiTheme.scale;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: UiTheme.accent-2;
                }
            }

            // Name + source→mount (stretches)
            VerticalLayout {
                spacing: 2px * UiTheme.scale;
                alignment: center;
                horizontal-stretch: 1;

                Text {
                    text: root.data.name;
                    font-size: 13px * UiTheme.scale;
                    font-weight: 600;
                    font-family: "JetBrains Mono";
                    color: UiTheme.fg-0;
                    overflow: elide;
                }

                Text {
                    text: root.data.source + "  →  " + root.data.mount;
                    font-size: 11px * UiTheme.scale;
                    font-family: "JetBrains Mono";
                    color: UiTheme.fg-3;
                    overflow: elide;
                }
            }

            // RO/RW badge (dot + text)
            HorizontalLayout {
                spacing: 5px * UiTheme.scale;
                alignment: center;
                Rectangle {
                    width: 5px * UiTheme.scale;
                    height: 5px * UiTheme.scale;
                    border-radius: 999px;
                    background: root.data.readonly ? UiTheme.warn : UiTheme.ok;
                }
                Text {
                    text: root.data.readonly ? "RO" : "RW";
                    font-size: 10.5px * UiTheme.scale;
                    font-weight: 500;
                    font-family: "JetBrains Mono";
                    letter-spacing: 0.84px * UiTheme.scale;
                    color: root.data.readonly ? UiTheme.warn : UiTheme.ok;
                    vertical-alignment: center;
                }
            }

            // Chevron — source swap instead of rotation
            Image {
                source: root.expanded
                    ? @image-url("../icons/chevron-down.svg")
                    : @image-url("../icons/chevron.svg");
                width: 12px * UiTheme.scale;
                height: 12px * UiTheme.scale;
                colorize: UiTheme.fg-3;
                opacity: 0.6;
            }
        }

        // ── Expanded detail section
        if root.expanded: Rectangle {
            height: 0.5px * UiTheme.scale;
            background: UiTheme.line;
        }

        if root.expanded: HorizontalLayout {
            padding-left: 16px * UiTheme.scale;
            padding-right: 16px * UiTheme.scale;
            padding-top: 12px * UiTheme.scale;
            padding-bottom: 12px * UiTheme.scale;
            spacing: 16px * UiTheme.scale;
            alignment: space-between;

            // KV column
            VerticalLayout {
                spacing: 4px * UiTheme.scale;
                horizontal-stretch: 1;

                if root.data.cipher != "": HorizontalLayout {
                    spacing: 14px * UiTheme.scale;
                    Text {
                        text: "cipher";
                        font-size: 11.5px * UiTheme.scale;
                        font-family: "JetBrains Mono";
                        color: UiTheme.fg-3;
                        min-width: 56px * UiTheme.scale;
                    }
                    Text {
                        text: root.data.cipher;
                        font-size: 11.5px * UiTheme.scale;
                        font-family: "JetBrains Mono";
                        color: UiTheme.fg-1;
                    }
                }

                HorizontalLayout {
                    spacing: 14px * UiTheme.scale;
                    Text {
                        text: "mode";
                        font-size: 11.5px * UiTheme.scale;
                        font-family: "JetBrains Mono";
                        color: UiTheme.fg-3;
                        min-width: 56px * UiTheme.scale;
                    }
                    Text {
                        text: (root.data.readonly ? "read-only" : "read/write") + (root.data.unprivileged ? " · unprivileged" : "");
                        font-size: 11.5px * UiTheme.scale;
                        font-family: "JetBrains Mono";
                        color: UiTheme.fg-1;
                    }
                }
            }

            ActionButton {
                text: "Unmount & lock";
                enabled: root.enabled;
                tone: "primary";
                icon: @image-url("../icons/eject.svg");
                has-icon: true;
                clicked => { root.unmount-clicked(); }
            }
        }
    }

    t := TouchArea {
        enabled: root.enabled && !root.expanded;
        clicked => {
            root.expanded = !root.expanded;
            root.clicked();
        }
    }

    // When expanded, the touch-area over the top row to allow collapse
    if root.expanded: TouchArea {
        height: 54px * UiTheme.scale;
        y: 0;
        clicked => {
            root.expanded = false;
            root.clicked();
        }
    }
}
