import { HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";
import { ActionButton, LurkerCheckBox, SelectField } from "controls.slint";
import { UiTheme } from "theme.slint";

export { ZoomMetricsWindow } from "zoom-metrics.slint";

component TitleText inherits Text {
    in property <length> text_size: 30px;
    font-size: root.text_size;
    font-weight: 700;
    color: #111827;
}

component SectionTitle inherits Text {
    in property <length> text_size: 22px;
    font-size: root.text_size;
    font-weight: 700;
    color: #111827;
}

component BodyText inherits Text {
    in property <length> text_size: 16px;
    font-size: root.text_size;
    color: #111827;
}

component SecondaryText inherits Text {
    in property <length> text_size: 16px;
    font-size: root.text_size;
    color: #4b5563;
    wrap: word-wrap;
}

component ThemedLineEdit inherits LineEdit {
    in property <length> text_size: 16px;
    font-size: root.text_size;
    min-height: max(UiTheme.control-min-height, root.text_size + 18px);
    horizontal-stretch: 1;
}

export component MainWindow inherits Window {
    title: "Lurker";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 980px;
    min-height: 680px;

    in-out property <float> ui_scale: 1.0;
    in-out property <string> zoom_label: "100%";
    private property <length> body_font_size: 16px * root.ui_scale;
    private property <length> title_font_size: 30px * root.ui_scale;
    private property <length> section_font_size: 22px * root.ui_scale;
    private property <length> tab_font_size: 16px * root.ui_scale;
    private property <string> current-tab: "create";

    in-out property <string> create-target: "";
    in-out property <string> create-size-gb: "4";
    in-out property <bool> create-force: false;
    in-out property <string> create-source-kind: "file";
    in-out property <string> create-volume-type: "luks";
    in-out property <string> create-cipher: "aes";
    in-out property <string> create-passphrase: "";
    in-out property <string> create-passphrase-confirm: "";

    in-out property <string> mount-source: "";
    in-out property <string> mount-mountpoint: "";
    in-out property <string> mount-tag: "";
    in-out property <string> mount-volume-type: "auto";
    in-out property <string> mount-passphrase: "";

    in-out property <string> unmount-target: "";
    in-out property <string> unmount-tag: "";
    in-out property <string> unmount-volume-type: "auto";

    in-out property <bool> busy: false;
    in-out property <string> busy-label: "";
    in-out property <string> status-message: "";
    in-out property <string> error-message: "";

    in property <[string]> active-volume-items: [];

    callback submit-create();
    callback submit-mount();
    callback submit-unmount();
    callback refresh-volumes();
    callback active-volume-picked(int);
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();

    Rectangle {
        background: #f4f6fa;

        VerticalBox {
            padding: UiTheme.outer-padding;
            spacing: UiTheme.panel-gap;

            Rectangle {
                min-height: 82px;
                background: #ffffff;
                border-width: 1px;
                border-color: #d5dbe6;
                border-radius: UiTheme.panel-radius;

                HorizontalBox {
                    padding: UiTheme.panel-padding;
                    spacing: UiTheme.panel-gap;

                    VerticalBox {
                        spacing: 6px;

                        TitleText {
                            text: "Lurker";
                            text_size: root.title_font_size;
                        }

                        BodyText {
                            text: root.busy ? root.busy-label : root.status-message;
                            text_size: root.body_font_size;
                            color: root.busy ? #1d4ed8 : #1f2937;
                            visible: root.busy || root.status-message != "";
                            wrap: word-wrap;
                        }

                        BodyText {
                            text: root.error-message;
                            text_size: root.body_font_size;
                            color: #b42318;
                            visible: root.error-message != "";
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    HorizontalBox {
                        spacing: 6px;

                        ActionButton {
                            text: "A-";
                            text_size: root.body_font_size;
                            enabled: !root.busy;
                            clicked => {
                                root.zoom-out();
                            }
                        }

                        ActionButton {
                            text: root.zoom_label;
                            text_size: root.body_font_size;
                            enabled: !root.busy;
                            clicked => {
                                root.zoom-reset();
                            }
                        }

                        ActionButton {
                            text: "A+";
                            text_size: root.body_font_size;
                            enabled: !root.busy;
                            clicked => {
                                root.zoom-in();
                            }
                        }
                    }

                    ActionButton {
                        text: "Refresh";
                        text_size: root.body_font_size;
                        enabled: !root.busy;
                        clicked => {
                            root.refresh-volumes();
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: UiTheme.panel-gap;

                Rectangle {
                    horizontal-stretch: 3;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #d5dbe6;
                    border-radius: UiTheme.panel-radius;

                    VerticalBox {
                        padding: UiTheme.panel-padding;
                        spacing: UiTheme.panel-gap;

                        HorizontalBox {
                            spacing: UiTheme.item-gap;

                            ActionButton {
                                text: "Create";
                                text_size: root.tab_font_size;
                                active: root.current-tab == "create";
                                enabled: !root.busy;
                                clicked => {
                                    root.current-tab = "create";
                                }
                            }

                            ActionButton {
                                text: "Mount";
                                text_size: root.tab_font_size;
                                active: root.current-tab == "mount";
                                enabled: !root.busy;
                                clicked => {
                                    root.current-tab = "mount";
                                }
                            }

                            ActionButton {
                                text: "Unmount";
                                text_size: root.tab_font_size;
                                active: root.current-tab == "unmount";
                                enabled: !root.busy;
                                clicked => {
                                    root.current-tab = "unmount";
                                }
                            }
                        }

                        ScrollView {
                            if root.current-tab == "create" : VerticalBox {
                                padding-bottom: UiTheme.section-gap;
                                spacing: UiTheme.section-gap;

                                SecondaryText {
                                    text: "Create a file container or destructive block device.";
                                    text_size: root.body_font_size;
                                }

                                BodyText {
                                    text: "Target path";
                                    text_size: root.body_font_size;
                                }
                                ThemedLineEdit {
                                    text <=> root.create-target;
                                    text_size: root.body_font_size;
                                    placeholder-text: "/path/to/vault.img or /dev/sdb1";
                                    enabled: !root.busy;
                                }

                                HorizontalBox {
                                    spacing: UiTheme.section-gap;

                                    VerticalBox {
                                        spacing: 6px;

                                        BodyText {
                                            text: "Target kind";
                                            text_size: root.body_font_size;
                                        }
                                        SelectField {
                                            model: ["file", "block"];
                                            value: root.create-source-kind;
                                            text_size: root.body_font_size;
                                            enabled: !root.busy;
                                            selected(value) => {
                                                root.create-source-kind = value;
                                            }
                                        }
                                    }

                                    VerticalBox {
                                        spacing: 6px;

                                        BodyText {
                                            text: "Volume type";
                                            text_size: root.body_font_size;
                                        }
                                        SelectField {
                                            model: ["luks", "veracrypt"];
                                            value: root.create-volume-type;
                                            text_size: root.body_font_size;
                                            enabled: !root.busy;
                                            selected(value) => {
                                                root.create-volume-type = value;
                                            }
                                        }
                                    }
                                }

                                BodyText {
                                    text: "Cipher";
                                    text_size: root.body_font_size;
                                }
                                SelectField {
                                    model: ["aes", "serpent", "twofish"];
                                    value: root.create-cipher;
                                    text_size: root.body_font_size;
                                    enabled: !root.busy;
                                    selected(value) => {
                                        root.create-cipher = value;
                                    }
                                }

                                BodyText {
                                    text: "Size in GB";
                                    text_size: root.body_font_size;
                                    color: root.create-source-kind == "block" ? #9ca3af : #111827;
                                }
                                ThemedLineEdit {
                                    text <=> root.create-size-gb;
                                    text_size: root.body_font_size;
                                    input-type: number;
                                    placeholder-text: "4";
                                    enabled: root.create-source-kind == "file" && !root.busy;
                                }

                                BodyText {
                                    text: "Passphrase";
                                    text_size: root.body_font_size;
                                }
                                ThemedLineEdit {
                                    text <=> root.create-passphrase;
                                    text_size: root.body_font_size;
                                    input-type: password;
                                    placeholder-text: "Required";
                                    enabled: !root.busy;
                                }

                                BodyText {
                                    text: "Confirm passphrase";
                                    text_size: root.body_font_size;
                                }
                                ThemedLineEdit {
                                    text <=> root.create-passphrase-confirm;
                                    text_size: root.body_font_size;
                                    input-type: password;
                                    placeholder-text: "Required";
                                    enabled: !root.busy;
                                }

                                LurkerCheckBox {
                                    text: root.create-source-kind == "block"
                                        ? "I understand block-device create is destructive."
                                        : "Overwrite the target file if it already exists.";
                                    checked <=> root.create-force;
                                    text_size: root.body_font_size;
                                    enabled: !root.busy;
                                }

                                ActionButton {
                                    text: "Create volume";
                                    text_size: root.body_font_size;
                                    primary: true;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.submit-create();
                                    }
                                }
                            }

                            if root.current-tab == "mount" : VerticalBox {
                                padding-bottom: UiTheme.section-gap;
                                spacing: UiTheme.section-gap;

                                SecondaryText {
                                    text: "Mount a LUKS or VeraCrypt volume.";
                                    text_size: root.body_font_size;
                                }

                                BodyText {
                                    text: "Source path";
                                    text_size: root.body_font_size;
                                }
                                ThemedLineEdit {
                                    text <=> root.mount-source;
                                    text_size: root.body_font_size;
                                    placeholder-text: "/path/to/vault.img or /dev/sdb1";
                                    enabled: !root.busy;
                                }

                                BodyText {
                                    text: "Mountpoint";
                                    text_size: root.body_font_size;
                                }
                                ThemedLineEdit {
                                    text <=> root.mount-mountpoint;
                                    text_size: root.body_font_size;
                                    placeholder-text: "/mnt/lurker";
                                    enabled: !root.busy;
                                }

                                BodyText {
                                    text: "Type";
                                    text_size: root.body_font_size;
                                }
                                SelectField {
                                    model: ["auto", "luks", "veracrypt"];
                                    value: root.mount-volume-type;
                                    text_size: root.body_font_size;
                                    enabled: !root.busy;
                                    selected(value) => {
                                        root.mount-volume-type = value;
                                    }
                                }

                                BodyText {
                                    text: "Tag";
                                    text_size: root.body_font_size;
                                    visible: root.mount-volume-type != "veracrypt";
                                }
                                ThemedLineEdit {
                                    text <=> root.mount-tag;
                                    text_size: root.body_font_size;
                                    placeholder-text: "Optional LUKS tag";
                                    visible: root.mount-volume-type != "veracrypt";
                                    enabled: root.mount-volume-type != "veracrypt" && !root.busy;
                                }

                                BodyText {
                                    text: "Passphrase";
                                    text_size: root.body_font_size;
                                }
                                ThemedLineEdit {
                                    text <=> root.mount-passphrase;
                                    text_size: root.body_font_size;
                                    input-type: password;
                                    placeholder-text: "Required";
                                    enabled: !root.busy;
                                }

                                ActionButton {
                                    text: "Mount volume";
                                    text_size: root.body_font_size;
                                    primary: true;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.submit-mount();
                                    }
                                }
                            }

                            if root.current-tab == "unmount" : VerticalBox {
                                padding-bottom: UiTheme.section-gap;
                                spacing: UiTheme.section-gap;

                                SecondaryText {
                                    text: "Unmount by mountpoint, mapper, or original source path.";
                                    text_size: root.body_font_size;
                                }

                                BodyText {
                                    text: "Target";
                                    text_size: root.body_font_size;
                                }
                                ThemedLineEdit {
                                    text <=> root.unmount-target;
                                    text_size: root.body_font_size;
                                    placeholder-text: "/mnt/lurker or /dev/mapper/lurker_x";
                                    enabled: !root.busy;
                                }

                                BodyText {
                                    text: "Type";
                                    text_size: root.body_font_size;
                                }
                                SelectField {
                                    model: ["auto", "luks", "veracrypt"];
                                    value: root.unmount-volume-type;
                                    text_size: root.body_font_size;
                                    enabled: !root.busy;
                                    selected(value) => {
                                        root.unmount-volume-type = value;
                                    }
                                }

                                BodyText {
                                    text: "Tag";
                                    text_size: root.body_font_size;
                                    visible: root.unmount-volume-type != "veracrypt";
                                }
                                ThemedLineEdit {
                                    text <=> root.unmount-tag;
                                    text_size: root.body_font_size;
                                    placeholder-text: "Optional LUKS tag";
                                    visible: root.unmount-volume-type != "veracrypt";
                                    enabled: root.unmount-volume-type != "veracrypt" && !root.busy;
                                }

                                ActionButton {
                                    text: "Unmount volume";
                                    text_size: root.body_font_size;
                                    primary: true;
                                    enabled: !root.busy;
                                    clicked => {
                                        root.submit-unmount();
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 2;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #d5dbe6;
                    border-radius: UiTheme.panel-radius;

                    VerticalBox {
                        padding: UiTheme.panel-padding;
                        spacing: UiTheme.section-gap;

                        SectionTitle {
                            text: "Active Volumes";
                            text_size: root.section_font_size;
                        }

                        SecondaryText {
                            text: "Select an item to prefill the unmount target.";
                            text_size: root.body_font_size;
                        }

                        if root.active-volume-items.length == 0 : SecondaryText {
                            text: "No active volumes detected.";
                            text_size: root.body_font_size;
                            color: #6b7280;
                        }

                        if root.active-volume-items.length > 0 : ScrollView {
                            VerticalBox {
                                padding-bottom: UiTheme.section-gap;
                                spacing: UiTheme.item-gap;

                                for volume[index] in root.active-volume-items : ActionButton {
                                    text: volume;
                                    text_size: root.body_font_size;
                                    enabled: !root.busy;
                                    left-aligned: true;
                                    fill-width: true;
                                    clicked => {
                                        root.active-volume-picked(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
