// Lurker MainWindow — 2-pane reskinned layout.
// Sidebar (220px) + main (header + scrollable view). OS-provided titlebar.
// Views: "create" | "manage".

import { Palette, ScrollView } from "std-widgets.slint";
import { UiTheme } from "theme.slint";

// Fonts — auto-registered at MainWindow::new() time by the Slint compiler
import "fonts/InterTight-Regular.ttf";
import "fonts/InterTight-Medium.ttf";
import "fonts/InterTight-SemiBold.ttf";
import "fonts/InterTight-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";

import { Glow, Toast, ToastData } from "components/primitives.slint";
import { IconAction } from "components/inputs.slint";
import { Sidebar, NavItem, NavLabel, SideFoot, MainHeader } from "components/chrome.slint";
import { VolumeRow, VolumeRowData } from "components/volume-row.slint";

import { CreateView } from "views/create.slint";
import { ManageView } from "views/manage.slint";

export { ZoomMetricsWindow } from "zoom-metrics.slint";
export { VolumeRowData } from "components/volume-row.slint";
export { ToastData } from "components/primitives.slint";

export component MainWindow inherits Window {
    title: "Lurker";
    preferred-width: 1340px;
    preferred-height: 860px;
    min-width: 1180px;
    min-height: 720px;
    default-font-family: "Inter Tight";
    default-font-size: 14px;
    background: UiTheme.bg-0;

    // ── Top-level state ──────────────────────────────────────────────
    in-out property <string> theme-mode: "system";
    in-out property <string> current-view: "create";
    in-out property <float> ui_scale: 1.0;
    in-out property <string> zoom_label: "100%";

    // Create flow
    in-out property <string> create-target-kind: "file";
    in-out property <string> create-format: "luks";
    in-out property <string> create-file-path: "~/vaults/";
    in-out property <string> create-file-name: "archive.luks";
    in-out property <string> create-partition: "/dev/sdb1";
    in-out property <string> create-size: "1.0";
    in-out property <string> create-size-unit: "GB";
    in-out property <string> create-cipher: "aes";
    in-out property <string> create-passphrase: "";
    in-out property <string> create-confirm: "";

    // Mount flow
    in-out property <string> mount-source-kind: "file";
    in-out property <string> mount-source: "";
    in-out property <string> mount-point: "/mnt/";
    in-out property <string> mount-auth-method: "pass";
    in-out property <string> mount-passphrase: "";
    in-out property <string> mount-key-file: "";
    in-out property <bool>   mount-readonly: false;
    in-out property <int>    mount-selected-index: -1;

    // Data
    in property <[VolumeRowData]> volumes: [];
    in property <[ToastData]> toasts: [];
    in property <string> backend-label: "LINUX";

    // ── Callbacks (only ones with Rust side) ──────────────────────────
    callback submit-create();
    callback submit-mount();
    callback reset-mount();
    callback unmount-volume(int);
    callback refresh-volumes();

    init => {
        UiTheme.mode = root.theme-mode;
        focus-scope.focus();
    }
    changed theme-mode => {
        UiTheme.mode = root.theme-mode;
    }

    // ── Body ──────────────────────────────────────────────────────────
    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        // Zoom / view-switch are pure Slint state (no disk persistence).
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "1") {
                    root.current-view = "create";
                    return accept;
                }
                if (event.text == "2") {
                    root.current-view = "manage";
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.current-view == "create") {
                        root.submit-create();
                    } else {
                        root.submit-mount();
                    }
                    return accept;
                }
                if (event.text == "=" || event.text == "+") {
                    root.ui_scale = min(2.0, root.ui_scale + 0.1);
                    return accept;
                }
                if (event.text == "-") {
                    root.ui_scale = max(0.8, root.ui_scale - 0.1);
                    return accept;
                }
                if (event.text == "0") {
                    root.ui_scale = 1.0;
                    return accept;
                }
            }
            reject
        }

        HorizontalLayout {
            spacing: 0;

            // ── Sidebar ──
            Sidebar {
                brand-name: "Lurker";
                brand-tag: "LUKS · VERACRYPT";

                NavLabel { text: "ACTIONS"; }

                VerticalLayout {
                    padding-left: UiTheme.s2;
                    padding-right: UiTheme.s2;
                    padding-top: UiTheme.s1;
                    padding-bottom: 0;
                    spacing: 2px;

                    NavItem {
                        label: "Create";
                        icon: @image-url("icons/plus.svg");
                        kbd: "⌘1";
                        active: root.current-view == "create";
                        clicked => { root.current-view = "create"; }
                    }

                    NavItem {
                        label: "Manage";
                        icon: @image-url("icons/lock-open.svg");
                        kbd: "⌘2";
                        active: root.current-view == "manage";
                        clicked => { root.current-view = "manage"; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                SideFoot {
                    mounted-count: root.volumes.length;
                    backend: root.backend-label;
                }
            }

            // ── Main area ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;

                MainHeader {
                    title: root.current-view == "create"
                        ? "Create encrypted container"
                        : "Manage volumes";
                    subtitle: root.current-view == "create"
                        ? "Make a new encrypted file or partition."
                        : "Mounted volumes, and unlock new ones.";

                    IconAction {
                        icon: UiTheme.dark
                            ? @image-url("icons/sun.svg")
                            : @image-url("icons/moon.svg");
                        size: 34px;
                        icon-size: 15px;
                        variant: "round";
                        tint: UiTheme.fg-1;
                        tooltip: UiTheme.dark ? "Switch to light mode" : "Switch to dark mode";
                        clicked => {
                            root.theme-mode = UiTheme.dark ? "light" : "dark";
                        }
                    }
                }

                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    Rectangle {
                        background: UiTheme.bg-0;
                        clip: true;

                        Glow {
                            x: -180px;
                            y: -240px;
                        }

                        // .work-wrap — 720px centered column.
                        // Three-child layout with flex spacers avoids the
                        // `width: min(720px, parent.width - …)` binding loop.
                        HorizontalLayout {
                            padding-top: UiTheme.s5;
                            padding-bottom: UiTheme.s6;

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            wrap := VerticalLayout {
                                width: 720px;

                            if root.current-view == "create": CreateView {
                                target-kind <=> root.create-target-kind;
                                format <=> root.create-format;
                                file-path <=> root.create-file-path;
                                file-name <=> root.create-file-name;
                                partition <=> root.create-partition;
                                size <=> root.create-size;
                                size-unit <=> root.create-size-unit;
                                cipher <=> root.create-cipher;
                                passphrase <=> root.create-passphrase;
                                confirm <=> root.create-confirm;
                                submit => { root.submit-create(); }
                            }

                            if root.current-view == "manage": ManageView {
                                volumes: root.volumes;
                                selected-index <=> root.mount-selected-index;
                                mount-source-kind <=> root.mount-source-kind;
                                mount-source <=> root.mount-source;
                                mount-point <=> root.mount-point;
                                mount-auth-method <=> root.mount-auth-method;
                                mount-passphrase <=> root.mount-passphrase;
                                mount-key-file <=> root.mount-key-file;
                                mount-readonly <=> root.mount-readonly;
                                unmount(i) => { root.unmount-volume(i); }
                                submit-mount => { root.submit-mount(); }
                                reset-mount => { root.reset-mount(); }
                            }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }
    }

    // ── Toasts overlay ──
    toasts-overlay := Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
        width: 300px;
        height: toasts-col.preferred-height;
        background: transparent;

        toasts-col := VerticalLayout {
            alignment: end;
            spacing: 8px;

            for data in root.toasts: Toast {
                data: data;
            }
        }
    }
}
