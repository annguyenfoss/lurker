// Lurker MainWindow — 2-pane reskinned layout.
// Sidebar (220px) + main (header + scrollable view). OS-provided titlebar.
// Views: "create" | "manage".

import { Palette, ScrollView } from "std-widgets.slint";
import { UiTheme } from "theme.slint";

// Fonts — auto-registered at MainWindow::new() time by the Slint compiler
import "fonts/InterTight-Regular.ttf";
import "fonts/InterTight-Medium.ttf";
import "fonts/InterTight-SemiBold.ttf";
import "fonts/InterTight-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";

import { Glow, Toast, ToastData, ZoomPill, Segmented } from "components/primitives.slint";
import { IconAction, DeviceInfo } from "components/inputs.slint";
import { Sidebar, NavItem, NavLabel, SideFoot, MainHeader } from "components/chrome.slint";
import { VolumeRow, VolumeRowData } from "components/volume-row.slint";

import { CreateView } from "views/create.slint";
import { KeyslotsView } from "views/keyslots.slint";
import { ManageView } from "views/manage.slint";

export { ZoomMetricsWindow } from "zoom-metrics.slint";
export { VolumeRowData } from "components/volume-row.slint";
export { ToastData } from "components/primitives.slint";
export { DeviceInfo } from "components/inputs.slint";

export component MainWindow inherits Window {
    title: "Lurker";
    preferred-width: 1340px * UiTheme.scale;
    preferred-height: 860px * UiTheme.scale;
    min-width: 1180px * UiTheme.scale;
    min-height: 720px * UiTheme.scale;
    default-font-family: "Inter Tight";
    default-font-size: 14px * UiTheme.scale;
    background: UiTheme.bg-0;

    // ── Top-level state ──────────────────────────────────────────────
    in-out property <string> theme-mode: "system";
    in-out property <string> current-view: "create";
    in-out property <float> ui_scale: 1.0;
    in-out property <string> zoom_label: "100%";
    in-out property <string> privilege-mode: "privileged";
    in property <bool> operation-busy: false;
    private property <bool> unprivileged: root.is-linux && root.privilege-mode == "unprivileged";

    // Create flow
    in-out property <string> create-target-kind: "file";
    in-out property <string> create-format: "luks";
    in-out property <string> create-file-path: "~/vaults/";
    in-out property <string> create-file-name: "archive.luks";
    in-out property <string> create-peer-source: "";
    in-out property <string> create-partition: "";
    in-out property <string> create-size: "1.0";
    in-out property <string> create-size-unit: "GB";
    in-out property <string> create-cipher: "aes";
    in-out property <string> create-filesystem: "hammer2";
    in-out property <string> create-passphrase: "";
    in-out property <string> create-confirm: "";
    in-out property <string> create-auth-method: "pass";
    in-out property <string> create-key-file: "";

    // LUKS credential management
    in-out property <string> keys-source: "";
    in-out property <string> keys-operation: "list";
    in-out property <string> keys-slot: "";
    in-out property <string> keys-auth-method: "pass";
    in-out property <string> keys-passphrase: "";
    in-out property <string> keys-key-file: "";
    in-out property <string> keys-new-auth-method: "pass";
    in-out property <string> keys-new-passphrase: "";
    in-out property <string> keys-confirm: "";
    in-out property <string> keys-new-key-file: "";
    in-out property <string> keys-result: "";

    // Mount flow
    in-out property <bool> mount-mirrored: false;
    in-out property <string> mount-peer-source: "";
    in-out property <bool> mount-degraded: false;
    in-out property <string> mount-source-kind: "file";
    in-out property <string> mount-source: "";
    in-out property <string> mount-point: "/mnt/";
    in-out property <string> mount-auth-method: "pass";
    in-out property <string> mount-passphrase: "";
    in-out property <string> mount-key-file: "";
    in-out property <int>    mount-selected-index: -1;

    // Data
    in property <[VolumeRowData]> volumes: [];
    in property <[ToastData]> toasts: [];
    in property <[DeviceInfo]> devices: [];
    in property <string> create-partition-label;   // meta shown in DevicePicker
    in property <string> mount-source-label;       // meta shown in DevicePicker
    in property <bool> is-macos: false;
    in property <string> platform-os: "linux";
    out property <bool> is-linux: root.platform-os == "linux" && !root.is-macos;
    in property <[string]> create-formats: ["luks", "luks1", "vera", "gocryptfs", "cryfs", "cryptomator"];
    in property <string> backend-label: "LINUX";

    // ── Callbacks (only ones with Rust side) ──────────────────────────
    callback submit-create();
    callback submit-keyslots();
    callback generate-passphrase();
    callback submit-mount();
    callback reset-mount();
    callback unmount-volume(int);
    callback refresh-volumes();
    callback rescan-devices();
    callback device-picked-for-create(DeviceInfo);
    callback device-picked-for-mount(DeviceInfo);
    callback change-privilege-mode(string);

    init => {
        UiTheme.mode = root.theme-mode;
        UiTheme.scale = root.ui_scale;
        focus-scope.focus();
    }
    changed theme-mode => {
        UiTheme.mode = root.theme-mode;
    }
    changed ui_scale => {
        UiTheme.scale = root.ui_scale;
    }

    // ── Body ──────────────────────────────────────────────────────────
    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        // Zoom / view-switch are pure Slint state (no disk persistence).
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "1") {
                    root.current-view = "create";
                    return accept;
                }
                if (event.text == "2") {
                    root.current-view = "manage";
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.current-view == "create") {
                        root.submit-create();
                    } else if root.current-view == "keys" {
                        root.submit-keyslots();
                    } else {
                        root.submit-mount();
                    }
                    return accept;
                }
                if (event.text == "=" || event.text == "+") {
                    root.ui_scale = UiTheme.zoom-step-up(root.ui_scale);
                    return accept;
                }
                if (event.text == "-") {
                    root.ui_scale = UiTheme.zoom-step-down(root.ui_scale);
                    return accept;
                }
                if (event.text == "0") {
                    root.ui_scale = 1.0;
                    return accept;
                }
            }
            reject
        }

        HorizontalLayout {
            spacing: 0;

            // ── Sidebar ──
            Sidebar {
                brand-name: "Lurker";
                brand-tag: "ENCRYPTED STORAGE";

                NavLabel { text: "ACTIONS"; }

                VerticalLayout {
                    padding-left: UiTheme.s2;
                    padding-right: UiTheme.s2;
                    padding-top: UiTheme.s1;
                    padding-bottom: 0;
                    spacing: 2px * UiTheme.scale;

                    NavItem {
                        label: "Create";
                        icon: @image-url("icons/plus.svg");
                        kbd: "⌘1";
                        active: root.current-view == "create";
                        clicked => { root.current-view = "create"; }
                    }

                    NavItem {
                        label: "Manage";
                        icon: @image-url("icons/lock-open.svg");
                        kbd: "⌘2";
                        active: root.current-view == "manage";
                        clicked => { root.current-view = "manage"; }
                    }
                    if root.is-linux && !root.unprivileged: NavItem {
                        label: "LUKS keys";
                        icon: @image-url("icons/key.svg");
                        active: root.current-view == "keys";
                        clicked => { root.current-view = "keys"; }
                    }

                }

                Rectangle { vertical-stretch: 1; }

                SideFoot {
                    mounted-count: root.volumes.length;
                    backend: root.backend-label;
                }
            }

            // ── Main area ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;

                MainHeader {
                    title: root.current-view == "create"
                        ? "Create encrypted storage"
                        : root.current-view == "keys" ? "Manage LUKS credentials" : "Manage volumes";
                    subtitle: root.current-view == "create"
                        ? (root.unprivileged ? "Create encrypted files and directories without administrator prompts." : "Make a new encrypted container or directory.")
                        : root.current-view == "keys" ? "Each enrolled password or key file unlocks independently."
                        : (root.unprivileged ? "Unlock VeraCrypt files without administrator prompts." : "Mounted volumes, and unlock new ones.");

                    if root.is-linux: Segmented {
                        value <=> root.privilege-mode;
                        enabled: !root.operation-busy;
                        options: [
                            { value: "privileged", label: "Privileged" },
                            { value: "unprivileged", label: "Unprivileged" },
                        ];
                        selected(value) => { root.change-privilege-mode(value); }
                    }

                    ZoomPill {
                        value: root.ui_scale;
                        changed(v) => { root.ui_scale = v; }
                    }

                    IconAction {
                        icon: UiTheme.dark
                            ? @image-url("icons/sun.svg")
                            : @image-url("icons/moon.svg");
                        size: 34px * UiTheme.scale;
                        icon-size: 15px * UiTheme.scale;
                        variant: "round";
                        tint: UiTheme.fg-1;
                        tooltip: UiTheme.dark ? "Switch to light mode" : "Switch to dark mode";
                        clicked => {
                            root.theme-mode = UiTheme.dark ? "light" : "dark";
                        }
                    }
                }

                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: max(self.visible-height, work-layout.preferred-height);

                    Rectangle {
                        background: UiTheme.bg-0;
                        clip: true;

                        Glow {
                            x: -180px * UiTheme.scale;
                            y: -240px * UiTheme.scale;
                        }

                        // .work-wrap — 720px centered column.
                        // Three-child layout with flex spacers avoids the
                        // `width: min(720px, parent.width - …)` binding loop.
                        work-layout := HorizontalLayout {
                            padding-top: UiTheme.s5;
                            padding-bottom: UiTheme.s6;

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            wrap := VerticalLayout {
                                width: UiTheme.work-wrap-max;

                            if root.current-view == "create": CreateView {
                                is-macos: root.is-macos;
                                is-linux: root.is-linux;
                                is-netbsd: root.platform-os == "netbsd";
                                is-freebsd: root.platform-os == "freebsd";
                                is-openbsd: root.platform-os == "openbsd";
                                is-dragonfly: root.platform-os == "dragonfly";
                                formats: root.create-formats;
                                unprivileged: root.unprivileged;
                                busy: root.operation-busy;
                                target-kind <=> root.create-target-kind;
                                format <=> root.create-format;
                                file-path <=> root.create-file-path;
                                file-name <=> root.create-file-name;
                                partition <=> root.create-partition;
                                peer-source <=> root.create-peer-source;
                                partition-label: root.create-partition-label;
                                size <=> root.create-size;
                                size-unit <=> root.create-size-unit;
                                cipher <=> root.create-cipher;
                                filesystem <=> root.create-filesystem;
                                passphrase <=> root.create-passphrase;
                                confirm <=> root.create-confirm;
                                auth-method <=> root.create-auth-method;
                                key-file <=> root.create-key-file;
                                devices: root.devices;
                                device-picked(info) => { root.device-picked-for-create(info); }
                                rescan => { root.rescan-devices(); }
                                submit => { root.submit-create(); }
                                generate-passphrase => { root.generate-passphrase(); }
                            }

                            if root.current-view == "keys" && root.is-linux && !root.unprivileged: KeyslotsView {
                                busy: root.operation-busy;
                                source <=> root.keys-source;
                                operation <=> root.keys-operation;
                                slot <=> root.keys-slot;
                                auth-method <=> root.keys-auth-method;
                                passphrase <=> root.keys-passphrase;
                                key-file <=> root.keys-key-file;
                                new-auth-method <=> root.keys-new-auth-method;
                                new-passphrase <=> root.keys-new-passphrase;
                                confirm <=> root.keys-confirm;
                                new-key-file <=> root.keys-new-key-file;
                                result: root.keys-result;
                                submit => { root.submit-keyslots(); }
                            }

                            if root.current-view == "manage": ManageView {
                                is-macos: root.is-macos;
                                is-linux: root.is-linux;
                                is-netbsd: root.platform-os == "netbsd";
                                is-freebsd: root.platform-os == "freebsd";
                                is-openbsd: root.platform-os == "openbsd";
                                is-dragonfly: root.platform-os == "dragonfly";
                                supports-directories: root.is-linux || root.is-macos || root.platform-os == "freebsd" || root.platform-os == "netbsd" || root.platform-os == "openbsd";
                                supports-keyfile: root.platform-os != "netbsd";
                                supports-raid1c: root.platform-os == "openbsd";
                                mirrored <=> root.mount-mirrored;
                                peer-source <=> root.mount-peer-source;
                                degraded <=> root.mount-degraded;
                                unprivileged: root.unprivileged;
                                busy: root.operation-busy;
                                volumes: root.volumes;
                                selected-index <=> root.mount-selected-index;
                                mount-source-kind <=> root.mount-source-kind;
                                mount-source <=> root.mount-source;
                                mount-source-label: root.mount-source-label;
                                mount-point <=> root.mount-point;
                                mount-auth-method <=> root.mount-auth-method;
                                mount-passphrase <=> root.mount-passphrase;
                                mount-key-file <=> root.mount-key-file;
                                devices: root.devices;
                                device-picked(info) => { root.device-picked-for-mount(info); }
                                rescan => { root.rescan-devices(); }
                                unmount(i) => { root.unmount-volume(i); }
                                submit-mount => { root.submit-mount(); }
                                reset-mount => { root.reset-mount(); }
                            }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
        }
    }

    // ── Toasts overlay ──
    toasts-overlay := Rectangle {
        x: parent.width - self.width - 20px * UiTheme.scale;
        y: parent.height - self.height - 20px * UiTheme.scale;
        width: 300px * UiTheme.scale;
        height: toasts-col.preferred-height;
        background: transparent;

        toasts-col := VerticalLayout {
            alignment: end;
            spacing: 8px * UiTheme.scale;

            for data in root.toasts: Toast {
                data: data;
            }
        }
    }
}
