// CreateView — (themes/views.jsx:140-299)
// Four card sections: Format, Target, Cipher, Passphrase. Foot: Create button.

import { UiTheme } from "../theme.slint";
import {
    Card, CardSection, CardFoot, SectionHead, Segmented, SegmentOption,
    Field, PillSurface
} from "../components/primitives.slint";
import {
    ThemedLineEdit, SelectField, ActionButton, PassphraseInput, DevicePicker, DeviceInfo
} from "../components/inputs.slint";

export component CreateView inherits Card {
    in property <bool> is-macos: false;
    in-out property <string> target-kind: "file";   // "file" | "partition"
    in-out property <string> format: "luks";         // "luks" | "vera" | "apple"
    in-out property <string> file-path: "~/vaults/";
    in-out property <string> file-name: "archive.luks";
    in-out property <string> partition: "";
    in-out property <string> partition-label: "";
    in-out property <string> size: "1.0";
    in-out property <string> size-unit: "GB";        // "MB" | "GB"
    in-out property <string> cipher: "aes";          // "aes" | "serpent" | "twofish"
    in-out property <string> passphrase: "";
    in-out property <string> confirm: "";

    in property <[DeviceInfo]> devices;
    callback device-picked(DeviceInfo);
    callback rescan;

    callback submit;
    callback generate-passphrase;

    private property <bool> pass-match: root.passphrase.character-count > 0 && root.passphrase == root.confirm;
    private property <bool> can-submit:
        (root.target-kind == "file" ? root.file-name != "" : root.partition != "")
        && root.passphrase.character-count >= 8
        && root.pass-match;

    // ── Format section ────────────────────────────────────────────────
    CardSection {
        top-divider: false;
        SectionHead { title: "FORMAT"; hint: "first is default"; }
        Segmented {
            value <=> root.format;
            options: [
                { value: root.is-macos ? "apple" : "luks", label: root.is-macos ? "Apple Encryption" : "LUKS" },
                { value: "vera", label: "VeraCrypt" },
            ];
        }
    }

    // ── Target section ────────────────────────────────────────────────
    CardSection {
        SectionHead { title: "TARGET"; hint: root.is-macos ? "file container" : "file or partition"; }

        Rectangle { height: UiTheme.s3; }   // spacer

        if !root.is-macos: Segmented {
            value <=> root.target-kind;
            options: [
                { value: "file",      label: "File container" },
                { value: "partition", label: "Partition / disk" },
            ];
        }

        Rectangle { height: UiTheme.s3; }   // spacer

        if root.target-kind == "file": VerticalLayout {
            spacing: UiTheme.s4;

            Field {
                label: "Location";
                required: true;
                ThemedLineEdit {
                    text <=> root.file-path;
                }
            }

            HorizontalLayout {
                spacing: UiTheme.s4;
                Field {
                    label: "Filename";
                    required: true;
                    ThemedLineEdit {
                        text <=> root.file-name;
                    }
                }
                Field {
                    label: "Size";
                    required: true;
                    HorizontalLayout {
                        spacing: UiTheme.s2;
                        ThemedLineEdit {
                            text <=> root.size;
                            horizontal-stretch: 1;
                        }
                        SelectField {
                            value <=> root.size-unit;
                            model: ["MB", "GB"];
                            horizontal-stretch: 0;
                            min-width: 80px * UiTheme.scale;
                        }
                    }
                }
            }
        }

        if root.target-kind == "partition": VerticalLayout {
            spacing: UiTheme.s3;

            Field {
                label: "Partition";
                required: true;
                DevicePicker {
                    devices: root.devices;
                    value <=> root.partition;
                    selected-label: root.partition-label;
                    placeholder: "Pick /dev/sdX…";
                    picked(info) => { root.device-picked(info); }
                    rescan => { root.rescan(); }
                }
            }

            // Destructive warning banner (Lurker.html:230-238)
            if root.partition != "": Rectangle {
                min-height: 38px * UiTheme.scale;
                border-radius: UiTheme.radius-sm;
                border-width: 0.5px * UiTheme.scale;
                border-color: oklch(58%, 45%, 25deg, 35%);
                background: oklch(58%, 45%, 25deg, 10%);
                HorizontalLayout {
                    padding: 10px * UiTheme.scale;
                    spacing: 10px * UiTheme.scale;
                    alignment: start;
                    Image {
                        source: @image-url("../icons/info.svg");
                        width: 14px * UiTheme.scale;
                        height: 14px * UiTheme.scale;
                        colorize: UiTheme.danger;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "All data on " + root.partition + " will be erased.";
                        font-size: UiTheme.fs-sm;
                        font-family: "JetBrains Mono";
                        color: UiTheme.fg-1;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // ── Cipher section ────────────────────────────────────────────────
    CardSection {
        SectionHead { title: "CIPHER"; hint: root.format == "apple" ? "AES-256" : "pick one — the rest is handled for you"; }
        if root.format == "apple": Text {
            text: "AES-256";
            color: UiTheme.fg-1;
        }
        if root.format != "apple": Segmented {
            value <=> root.cipher;
            options: [
                { value: "aes",     label: "AES" },
                { value: "serpent", label: "Serpent" },
                { value: "twofish", label: "Twofish" },
            ];
        }
    }

    // ── Passphrase section ────────────────────────────────────────────
    CardSection {
        SectionHead { title: "PASSPHRASE"; hint: "min 8 characters"; }

        VerticalLayout {
            spacing: UiTheme.s3;

            Field {
                label: "Passphrase";
                required: true;
                PassphraseInput {
                    text <=> root.passphrase;
                    show-strength-button: true;
                    generate-requested => {
                        root.generate-passphrase();
                    }
                }
            }

            Field {
                label: "Confirm";
                // Confirm input with live match indicator
                Rectangle {
                    min-height: 34px * UiTheme.scale;
                    preferred-height: 34px * UiTheme.scale;
                    horizontal-stretch: 1;
                    field := ThemedLineEdit {
                        width: parent.width;
                        height: parent.height;
                        text <=> root.confirm;
                        input-type: InputType.password;
                        placeholder-text: "retype to confirm";
                        suffix-reserved: root.confirm != "" ? 68px * UiTheme.scale : 0px * UiTheme.scale;
                    }
                    if root.confirm != "": Rectangle {
                        x: parent.width - 64px * UiTheme.scale - 8px * UiTheme.scale;
                        y: (parent.height - 22px * UiTheme.scale) / 2;
                        width: 64px * UiTheme.scale;
                        height: 22px * UiTheme.scale;
                        Text {
                            text: root.pass-match ? "matches" : "mismatch";
                            font-size: 10.5px * UiTheme.scale;
                            font-family: "JetBrains Mono";
                            color: root.pass-match ? UiTheme.ok : UiTheme.danger;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // ── Card foot ────────────────────────────────────────────────────
    CardFoot {
        Rectangle { horizontal-stretch: 1; }  // spacer

        ActionButton {
            text: "Create";
            tone: "primary";
            icon: @image-url("../icons/plus.svg");
            has-icon: true;
            kbd: "⌘⏎";
            enabled: root.can-submit;
            clicked => { root.submit(); }
        }
    }
}
