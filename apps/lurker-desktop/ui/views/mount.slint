// MountView — (themes/views.jsx:303-423)
// Three card sections: Source, Unlock with, Mount. Foot: Reset + Unlock button.
// Zero-trace: no OS file-picker dialog. Users type paths directly (click on
// the Drop zone reveals an inline text input). Drag-drop future-work.

import { UiTheme } from "../theme.slint";
import {
    Card, CardSection, CardFoot, SectionHead, Segmented, SegmentOption,
    Field, Toggle
} from "../components/primitives.slint";
import {
    ThemedLineEdit, SelectField, ActionButton, PassphraseInput, KeyFilePicker,
    Drop, DevicePicker, DeviceInfo
} from "../components/inputs.slint";

export component MountView inherits Card {
    in property <bool> is-macos: false;
    in property <bool> is-linux: true;
    in property <bool> is-netbsd: false;
    in property <bool> is-freebsd: false;
    in property <bool> supports-directories: true;
    in property <bool> supports-keyfile: true;
    in property <bool> supports-raid1c: false;
    in-out property <bool> mirrored: false;
    in-out property <string> peer-source: "";
    in-out property <bool> degraded: false;
    changed mirrored => {
        root.peer-source = ""; root.degraded = false;
        if root.mirrored { root.auth-method = "pass"; root.key-file = ""; }
    }
    in property <bool> unprivileged: false;
    in property <bool> busy: false;
    in-out property <string> source-kind: "file";   // "file" | "partition"
    in-out property <string> source: "";
    in-out property <string> source-label: "";
    in-out property <string> mount-point: "/mnt/";
    in-out property <string> auth-method: "pass";   // "pass" | "key"
    in-out property <string> passphrase: "";
    in-out property <string> key-file: "";

    in property <[DeviceInfo]> devices;
    callback device-picked(DeviceInfo);
    callback rescan;

    callback submit;
    callback reset;

    changed supports-keyfile => { if !root.supports-keyfile { root.auth-method = "pass"; root.key-file = ""; } }
    changed auth-method => {
        if root.auth-method == "key" { root.passphrase = ""; }
        else { root.key-file = ""; }
    }

    // When the user clicks the Drop zone, switch to an inline text input so
    // they can type a path. No OS dialog => no recently-used traces on disk.
    private property <bool> typing-source: false;

    private property <bool> has-auth:
        root.auth-method == "pass"
            ? root.passphrase.character-count > 0
            : root.key-file != "";
    private property <bool> can-submit:
        !root.busy &&
        root.source != ""
        && root.has-auth
        && root.mount-point != "/mnt/"
        && root.mount-point != "/mnt"
        && root.mount-point != "/Volumes/"
        && root.mount-point != "/Volumes";

    private property <[SegmentOption]> linux-sources: [
        { value: "file", label: "File container" },
        { value: "directory", label: "Directory" },
        { value: "partition", label: "Partition / disk" },
    ];
    private property <[SegmentOption]> file-sources: [
        { value: "file", label: "File container" },
        { value: "directory", label: "Directory" },
    ];
    private property <[SegmentOption]> partition-sources: [
        { value: "file", label: "File container" },
        { value: "partition", label: "Partition / disk" },
    ];

    // ── Source section ────────────────────────────────────────────────
    CardSection {
        top-divider: false;
        SectionHead { title: "SOURCE"; hint: "encrypted container or directory to unlock"; }

        Rectangle { height: UiTheme.s3; }

        if root.supports-directories || root.is-linux || root.is-netbsd || root.is-freebsd: Segmented {
            value: root.source-kind;
            options: root.is-netbsd ? root.partition-sources : (root.is-macos || root.is-freebsd || (root.is-linux && !root.unprivileged)) ? root.linux-sources : root.file-sources;
            selected(v) => { root.source-kind = v; root.source = ""; }
        }

        Rectangle { height: UiTheme.s3; }

        if root.source-kind != "partition" && root.source == "" && !root.typing-source: Drop {
            icon: @image-url("../icons/file.svg");
            title: "Drop an encrypted file or directory here";
            subtitle: "or click to type a path · format detected automatically";
            clicked => { root.typing-source = true; }
            dropped(path) => { root.source = path; }
        }

        if root.source-kind != "partition" && (root.source != "" || root.typing-source): Rectangle {
            min-height: 34px * UiTheme.scale;
            preferred-height: 34px * UiTheme.scale;
            ThemedLineEdit {
                width: parent.width;
                height: parent.height;
                text <=> root.source;
                has-prefix: true;
                prefix-icon: @image-url("../icons/file.svg");
                placeholder-text: root.is-macos ? "~/archive.dmg" : "~/vaults/archive.luks";
                suffix-reserved: 30px * UiTheme.scale;
            }
            Rectangle {
                x: parent.width - 30px * UiTheme.scale;
                y: (parent.height - 26px * UiTheme.scale) / 2;
                width: 26px * UiTheme.scale;
                height: 26px * UiTheme.scale;
                Image {
                    source: @image-url("../icons/x.svg");
                    width: 13px * UiTheme.scale;
                    height: 13px * UiTheme.scale;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: UiTheme.fg-2;
                }
                TouchArea {
                    clicked => {
                        root.source = "";
                        root.typing-source = false;
                    }
                }
            }
        }

        if root.source-kind == "partition" && (root.is-macos || root.is-netbsd || root.is-freebsd): ThemedLineEdit {
            text <=> root.source;
            placeholder-text: root.is-netbsd ? "/dev/dkN" : root.is-macos ? "/dev/diskNsM" : "/dev/daNpM";
        }
        if root.source-kind == "partition" && !root.is-macos && !root.is-netbsd && !root.is-freebsd: DevicePicker {
            devices: root.devices;
            value <=> root.source;
            selected-label: root.source-label;
            placeholder: "Pick an encrypted partition";
            picked(info) => { root.device-picked(info); }
            rescan => { root.rescan(); }
        }
    }

    if root.supports-raid1c: CardSection {
        Toggle { label: "Mirrored softraid (RAID1C)"; checked <=> root.mirrored; }
        if root.mirrored: VerticalLayout {
            spacing: UiTheme.s3;
            Field {
                label: "Second member file";
                hint: "optional when the saved array descriptor is available";
                ThemedLineEdit { text <=> root.peer-source; }
            }
            Toggle {
                label: "Allow degraded recovery";
                hint: "open an existing mirror with one surviving member";
                checked <=> root.degraded;
            }
        }
    }

    // ── Unlock with section ───────────────────────────────────────────
    CardSection {
        SectionHead { title: "UNLOCK WITH"; hint: "passphrase or key file"; }

        VerticalLayout {
            spacing: UiTheme.s3;

            if root.supports-keyfile && !root.mirrored: Segmented {
                value <=> root.auth-method;
                options: [
                    { value: "pass", label: "Passphrase" },
                    { value: "key",  label: "Key file" },
                ];
            }

            if root.auth-method == "pass": PassphraseInput {
                text <=> root.passphrase;
                show-strength-button: false;
            }

            if root.auth-method == "key": KeyFilePicker {
                value <=> root.key-file;
            }

            if root.auth-method == "key": Text {
                text: "Key files require a format that supports them, such as LUKS, VeraCrypt, GELI or PEFS.";
                font-size: UiTheme.fs-sm;
                color: UiTheme.fg-2;
                wrap: word-wrap;
            }
        }
    }

    // ── Mount section ────────────────────────────────────────────────
    CardSection {
        SectionHead { title: "MOUNT"; hint: ""; }

        VerticalLayout {
            spacing: UiTheme.s3;

            Field {
                label: "Mount point";
                hint: "/mnt/…";
                required: true;
                ThemedLineEdit {
                    text <=> root.mount-point;
                    mono: true;
                }
            }

        }
    }

    // ── Card foot ────────────────────────────────────────────────────
    CardFoot {
        Rectangle { horizontal-stretch: 1; }  // spacer

        ActionButton {
            text: "Reset";
            tone: "ghost";
            clicked => { root.reset(); }
        }

        ActionButton {
            text: "Unlock & mount";
            tone: "primary";
            icon: @image-url("../icons/lock-open.svg");
            has-icon: true;
            kbd: "⌘⏎";
            enabled: root.can-submit;
            clicked => { root.submit(); }
        }
    }
}
