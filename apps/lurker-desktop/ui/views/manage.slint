// ManageView — (themes/views.jsx:534-658)
// Top card: mounted-volumes list with inline expandable unmount.
// Below: "Mount a volume" rule + inlined MountView.

import { UiTheme } from "../theme.slint";
import {
    Card, CardSection, CardFoot, SectionHead
} from "../components/primitives.slint";
import { VolumeRow, VolumeRowData } from "../components/volume-row.slint";
import { DeviceInfo } from "../components/inputs.slint";
import { MountView } from "mount.slint";

export component ManageView inherits Rectangle {
    in property <bool> is-macos: false;
    in property <bool> unprivileged: false;
    in property <bool> busy: false;
    in property <[VolumeRowData]> volumes;
    in-out property <int> selected-index: -1;

    // Mount form state — forwarded 1:1 from MainWindow
    in-out property <string> mount-source-kind: "file";
    in-out property <string> mount-source: "";
    in-out property <string> mount-source-label: "";
    in-out property <string> mount-point: "/mnt/";
    in-out property <string> mount-auth-method: "pass";
    in-out property <string> mount-passphrase: "";
    in-out property <string> mount-key-file: "";
    in-out property <bool>   mount-readonly: false;

    in property <[DeviceInfo]> devices;

    callback unmount(int);
    callback submit-mount();
    callback reset-mount();
    callback device-picked(DeviceInfo);
    callback rescan;

    VerticalLayout {
        spacing: UiTheme.s5;

        // ── Mounted volumes card ──────────────────────────────────────
        Card {
            CardSection {
                top-divider: false;
                SectionHead {
                    title: "MOUNTED VOLUMES";
                    hint: root.volumes.length == 1
                        ? "1 volume · click to manage"
                        : root.volumes.length + " volumes · click to manage";
                }

                if root.volumes.length == 0: Rectangle {
                    min-height: 110px * UiTheme.scale;
                    border-radius: UiTheme.radius;
                    border-width: 0.5px * UiTheme.scale;
                    border-color: UiTheme.line-strong;
                    background: UiTheme.bg-0;

                    VerticalLayout {
                        padding-top: UiTheme.s5;
                        padding-bottom: UiTheme.s5;
                        padding-left: UiTheme.s4;
                        padding-right: UiTheme.s4;
                        spacing: UiTheme.s3;
                        alignment: center;

                        Rectangle {
                            width: 40px * UiTheme.scale;
                            height: 40px * UiTheme.scale;
                            horizontal-stretch: 0;
                            x: (parent.width - self.width) / 2;
                            border-radius: 10px * UiTheme.scale;
                            background: UiTheme.bg-2;
                            Image {
                                source: @image-url("../icons/lock.svg");
                                width: 18px * UiTheme.scale;
                                height: 18px * UiTheme.scale;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: UiTheme.fg-3;
                            }
                        }

                        Text {
                            text: "Nothing mounted yet";
                            font-size: 13px * UiTheme.scale;
                            font-weight: 600;
                            font-family: "Inter Tight";
                            color: UiTheme.fg-1;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Unlock a container below to mount it here.";
                            font-size: 11.5px * UiTheme.scale;
                            font-family: "Inter Tight";
                            color: UiTheme.fg-3;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.volumes.length > 0: VerticalLayout {
                    spacing: 8px * UiTheme.scale;

                    for data[i] in root.volumes: VolumeRow {
                        data: data;
                        enabled: !root.busy && (!root.unprivileged || data.unprivileged);
                        expanded: root.selected-index == i;
                        clicked => {
                            if (root.selected-index == i) {
                                root.selected-index = -1;
                            } else {
                                root.selected-index = i;
                            }
                        }
                        unmount-clicked => {
                            root.unmount(i);
                        }
                    }
                }
            }
        }

        // ── "Mount a volume" divider label ────────────────────────────
        HorizontalLayout {
            spacing: UiTheme.s3;
            alignment: center;

            Rectangle {
                horizontal-stretch: 1;
                height: 0.5px * UiTheme.scale;
                y: 10px * UiTheme.scale;
                background: UiTheme.line;
            }

            Text {
                text: "MOUNT A VOLUME";
                font-size: 11px * UiTheme.scale;
                font-weight: 600;
                font-family: "Inter Tight";
                letter-spacing: 1.32px * UiTheme.scale;
                color: UiTheme.fg-2;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 0.5px * UiTheme.scale;
                y: 10px * UiTheme.scale;
                background: UiTheme.line;
            }
        }

        // ── Inlined MountView ────────────────────────────────────────
        MountView {
            is-macos: root.is-macos;
            unprivileged: root.unprivileged;
            busy: root.busy;
            source-kind <=> root.mount-source-kind;
            source <=> root.mount-source;
            source-label <=> root.mount-source-label;
            mount-point <=> root.mount-point;
            auth-method <=> root.mount-auth-method;
            passphrase <=> root.mount-passphrase;
            key-file <=> root.mount-key-file;
            readonly <=> root.mount-readonly;
            devices: root.devices;
            device-picked(info) => { root.device-picked(info); }
            rescan => { root.rescan(); }
            submit => { root.submit-mount(); }
            reset => { root.reset-mount(); }
        }
    }
}
