{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lurker",
  "version": "0.1.0",
  "identifier": "io.lurker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lurker",
        "width": 1180,
        "height": 840,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/lurker-helper"
    ]
  }
}
