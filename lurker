#!/bin/bash

set -euo pipefail

SCRIPT_NAME=$(basename -- "$0")

ESC_RESET=$'\033[0m'
ESC_BOLD_BLUE=$'\033[1;34m'
ESC_BOLD_GREEN=$'\033[1;32m'
ESC_BOLD_YELLOW=$'\033[1;33m'
ESC_BOLD_RED=$'\033[1;31m'

action=""
file_path=""
mount_path=""
file_size=""
umount_target=""
source_kind=""
mapper_tag=""
volume_type="auto"
volume_type_explicit=0
force_overwrite=0
cleanup_mapper=""
sudo_ready=0
color_mode="auto"
use_color_stdout=0
use_color_stderr=0
veracrypt_fallback_noticed=0

PARSED_ARGS=()
action_args=()
resolved_target_kind=""
resolved_mapper_name=""
resolved_mapper_path=""
resolved_mountpoint=""
resolved_origin=""

show_help() {
    local help_color=0
    local header=""
    local accent=""
    local reset=""

    case "$color_mode" in
        always)
            help_color=1
            ;;
        auto)
            if [[ -t 1 ]]; then
                help_color=1
            fi
            ;;
        never)
            ;;
    esac

    if [[ $help_color -eq 1 ]]; then
        header=$ESC_BOLD_BLUE
        accent=$ESC_BOLD_GREEN
        reset=$ESC_RESET
    fi

    cat <<EOF

${header}Usage:${reset}
  ${accent}$SCRIPT_NAME create [--type TYPE] <file> <size-gb> [-F|--force]${reset}
  ${accent}$SCRIPT_NAME create [--type TYPE] <block-device> [-F|--force]${reset}
  ${accent}$SCRIPT_NAME createvc <file> <size-gb> [-F|--force]${reset}
  ${accent}$SCRIPT_NAME createvc <block-device> [-F|--force]${reset}
  ${accent}$SCRIPT_NAME mount [--type TYPE] [-t TAG] <source> <mountpoint>${reset}
  ${accent}$SCRIPT_NAME umount [--type TYPE] [-t TAG] <target>${reset}
  ${accent}$SCRIPT_NAME help${reset}

${header}Examples:${reset}
  ${accent}$SCRIPT_NAME create ./vault.img 4${reset}
  ${accent}$SCRIPT_NAME create --type veracrypt ./vault.hc 4${reset}
  ${accent}$SCRIPT_NAME create /dev/sda2 --force${reset}
  ${accent}$SCRIPT_NAME createvc /dev/sdb2 --force${reset}
  ${accent}$SCRIPT_NAME mount ./vault.img /mnt/vault${reset}
  ${accent}$SCRIPT_NAME mount -t work /dev/sda2 /mnt/work${reset}
  ${accent}$SCRIPT_NAME umount /mnt/work${reset}
  ${accent}$SCRIPT_NAME umount -t work /dev/sda2${reset}

${header}Options:${reset}
  ${accent}-F, --force${reset}       Overwrite an existing file or allow destructive block-device create
  ${accent}-t TAG${reset}            Use /dev/mapper/lurker_TAG for mount or umount
  ${accent}--type TYPE${reset}       Container type: create uses luks|veracrypt; mount/umount use auto|luks|veracrypt
  ${accent}--color=WHEN${reset}      Color output: auto, always, never
  ${accent}-h, --help${reset}        Show this help text
EOF
}

print_prefixed_stdout() {
    local color=$1
    local prefix=$2
    shift 2

    if [[ $use_color_stdout -eq 1 ]]; then
        printf '%b%s%b %s\n' "$color" "$prefix" "$ESC_RESET" "$*"
    else
        printf '%s %s\n' "$prefix" "$*"
    fi
}

print_prefixed_stderr() {
    local color=$1
    local prefix=$2
    shift 2

    if [[ $use_color_stderr -eq 1 ]]; then
        printf '%b%s%b %s\n' "$color" "$prefix" "$ESC_RESET" "$*" >&2
    else
        printf '%s %s\n' "$prefix" "$*" >&2
    fi
}

msg() {
    print_prefixed_stdout "$ESC_BOLD_GREEN" "==>" "$*"
}

msg2() {
    print_prefixed_stdout "$ESC_BOLD_BLUE" "  ->" "$*"
}

success() {
    print_prefixed_stdout "$ESC_BOLD_GREEN" "==>" "$*"
}

die() {
    print_prefixed_stderr "$ESC_BOLD_RED" "error:" "$*"
    exit 1
}

# shellcheck disable=SC2329  # Used indirectly via cleanup_on_exit.
warn() {
    print_prefixed_stderr "$ESC_BOLD_YELLOW" "warning:" "$*"
}

validate_color_mode() {
    case "$color_mode" in
        auto | always | never)
            ;;
        *)
            die "Invalid --color value: $color_mode. Use auto, always, or never."
            ;;
    esac
}

validate_volume_type() {
    case "$volume_type" in
        auto | luks | veracrypt)
            ;;
        *)
            die "Invalid --type value: $volume_type. Use auto, luks, or veracrypt."
            ;;
    esac
}

setup_color() {
    use_color_stdout=0
    use_color_stderr=0

    case "$color_mode" in
        always)
            use_color_stdout=1
            use_color_stderr=1
            ;;
        auto)
            [[ -t 1 ]] && use_color_stdout=1
            [[ -t 2 ]] && use_color_stderr=1
            ;;
        never)
            ;;
    esac

    return 0
}

have_command() {
    command -v "$1" >/dev/null 2>&1
}

# shellcheck disable=SC2329  # Invoked indirectly via trap.
cleanup_on_exit() {
    local exit_code=$?

    if [[ $exit_code -ne 0 && -n ${cleanup_mapper:-} ]]; then
        if [[ -e "$(mapper_device_path "$cleanup_mapper")" ]]; then
            warn "Closing mapper ${cleanup_mapper} after failed action."
            if ! try_run_privileged cryptsetup close "$cleanup_mapper" >/dev/null 2>&1; then
                warn "Failed to close mapper ${cleanup_mapper} during cleanup."
            fi
        fi
    fi
}

trap cleanup_on_exit EXIT

require_command() {
    have_command "$1" || die "Required command not found: $1"
}

ensure_sudo() {
    if [[ $EUID -eq 0 ]]; then
        return
    fi

    require_command sudo

    if [[ $sudo_ready -eq 0 ]]; then
        msg2 "Refreshing sudo credentials"
        sudo -v
        sudo_ready=1
    fi
}

#
# shellcheck disable=SC2329  # Invoked indirectly via cleanup_on_exit.
try_ensure_sudo() {
    if [[ $EUID -eq 0 ]]; then
        return 0
    fi

    if ! have_command sudo; then
        return 1
    fi

    if [[ $sudo_ready -eq 0 ]]; then
        sudo -v >/dev/null 2>&1 || return 1
        sudo_ready=1
    fi
}

run_privileged() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
        return
    fi

    ensure_sudo
    sudo "$@"
}

# shellcheck disable=SC2329  # Invoked indirectly via cleanup_on_exit.
try_run_privileged() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
        return
    fi

    try_ensure_sudo || return 1
    sudo "$@"
}

parse_long_options() {
    local arg

    PARSED_ARGS=()

    while [[ $# -gt 0 ]]; do
        arg=$1

        case "$arg" in
            --color=*)
                color_mode=${arg#*=}
                shift
                ;;
            --color)
                [[ $# -ge 2 ]] || die "Option --color requires an argument."
                color_mode=$2
                shift 2
                ;;
            --type=*)
                volume_type=${arg#*=}
                volume_type_explicit=1
                shift
                ;;
            --type)
                [[ $# -ge 2 ]] || die "Option --type requires an argument."
                volume_type=$2
                volume_type_explicit=1
                shift 2
                ;;
            --help)
                PARSED_ARGS+=("-h")
                shift
                ;;
            --force)
                PARSED_ARGS+=("-F")
                shift
                ;;
            --)
                shift
                while [[ $# -gt 0 ]]; do
                    PARSED_ARGS+=("$1")
                    shift
                done
                ;;
            --*)
                show_help >&2
                die "Unsupported argument chosen: $arg"
                ;;
            *)
                PARSED_ARGS+=("$arg")
                shift
                ;;
        esac
    done
}

absolute_path() {
    local input_path=$1
    local parent_dir
    local base_name

    if have_command readlink; then
        if readlink -f -- "$input_path" >/dev/null 2>&1; then
            readlink -f -- "$input_path"
            return
        fi
    fi

    parent_dir=$(dirname -- "$input_path")
    base_name=$(basename -- "$input_path")
    parent_dir=$(cd -- "$parent_dir" && pwd -P)

    printf '%s/%s\n' "$parent_dir" "$base_name"
}

resolved_mapper_name_from_path() {
    local resolved_path=$1
    local base_name
    local safe_base_name
    local checksum

    base_name=$(basename -- "$resolved_path")
    safe_base_name=$(printf '%s' "$base_name" | tr -c 'A-Za-z0-9._-' '_')
    safe_base_name=${safe_base_name##_}
    safe_base_name=${safe_base_name%%_}

    if [[ -z $safe_base_name ]]; then
        safe_base_name="volume"
    fi

    checksum=$(printf '%s' "$resolved_path" | sha256sum | cut -c1-12)
    printf 'lurker_%s_%s\n' "${safe_base_name:0:48}" "$checksum"
}

mapper_name_for_path() {
    local resolved_path

    resolved_path=$(absolute_path "$1")
    resolved_mapper_name_from_path "$resolved_path"
}

mapper_name_for_tag() {
    local raw_tag=$1
    local safe_tag

    safe_tag=$(printf '%s' "$raw_tag" | tr -c 'A-Za-z0-9._-' '_')
    safe_tag=${safe_tag##_}
    safe_tag=${safe_tag%%_}

    [[ -n $safe_tag ]] || die "Tag must contain at least one usable character."

    printf 'lurker_%s\n' "${safe_tag:0:56}"
}

mapper_device_path() {
    printf '/dev/mapper/%s\n' "$1"
}

normalize_mapper_name() {
    local mapper_reference=$1

    mapper_reference=${mapper_reference#/dev/mapper/}
    printf '%s\n' "$mapper_reference"
}

canonical_device_path() {
    local device_path=$1

    if have_command readlink; then
        if readlink -f -- "$device_path" >/dev/null 2>&1; then
            readlink -f -- "$device_path"
            return
        fi
    fi

    printf '%s\n' "$device_path"
}

sysfs_block_path_for_device() {
    local canonical_device=$1
    local block_name=""

    canonical_device=$(canonical_device_path "$canonical_device")
    block_name=$(basename -- "$canonical_device")
    [[ -e /sys/class/block/$block_name ]] || return 1

    printf '/sys/class/block/%s\n' "$block_name"
}

device_identity_for_sysfs_block_path() {
    local sysfs_block_path=$1

    [[ -r $sysfs_block_path/dev ]] || return 1
    cat "$sysfs_block_path/dev"
}

device_identity_for_path() {
    local sysfs_block_path=""

    sysfs_block_path=$(sysfs_block_path_for_device "$1") || return 1
    device_identity_for_sysfs_block_path "$sysfs_block_path"
}

is_block_device_target() {
    [[ -b $1 ]]
}

source_kind_for_path() {
    if is_block_device_target "$1"; then
        printf 'block\n'
        return
    fi

    if [[ -f $1 ]]; then
        printf 'file\n'
        return
    fi

    return 1
}

mapper_name_for_block_device() {
    local resolved_path

    resolved_path=$(canonical_device_path "$1")
    resolved_mapper_name_from_path "$resolved_path"
}

mapper_name_for_source() {
    local source_path=$1
    local tag_override=${2:-}

    if [[ -n $tag_override ]]; then
        mapper_name_for_tag "$tag_override"
        return
    fi

    if is_block_device_target "$source_path"; then
        mapper_name_for_block_device "$source_path"
        return
    fi

    mapper_name_for_path "$source_path"
}

find_mount_source_for_mountpoint() {
    local target=$1

    findmnt -n -f -o SOURCE --mountpoint "$target" 2>/dev/null || true
}

find_mountpoint_for_source() {
    local source=$1
    local target=""
    local canonical_source=""

    target=$(findmnt -n -f -o TARGET --source "$source" 2>/dev/null || true)
    if [[ -n $target ]]; then
        printf '%s\n' "$target"
        return
    fi

    canonical_source=$(canonical_device_path "$source")
    if [[ $canonical_source != "$source" ]]; then
        target=$(findmnt -n -f -o TARGET --source "$canonical_source" 2>/dev/null || true)
        if [[ -n $target ]]; then
            printf '%s\n' "$target"
        fi
    fi
}

warn_ignored_umount_tag() {
    local target_kind=$1

    [[ -n ${mapper_tag:-} ]] || return

    case "$target_kind" in
        mapper)
            warn "Ignoring -t for /dev/mapper input; the explicit mapper path takes precedence."
            ;;
        mountpoint)
            warn "Ignoring -t for mountpoint input; the active mapper is resolved from the mounted filesystem."
            ;;
    esac
}

is_luks_source() {
    cryptsetup isLuks "$1" >/dev/null 2>&1
}

is_veracrypt_source() {
    cryptsetup tcryptDump --type tcrypt --veracrypt "$1" >/dev/null 2>&1
}

have_veracrypt() {
    have_command veracrypt
}

notice_veracrypt_fallback() {
    if [[ $veracrypt_fallback_noticed -eq 0 ]]; then
        msg2 "veracrypt not found; falling back to cryptsetup for veracrypt container"
        veracrypt_fallback_noticed=1
    fi
}

require_supported_veracrypt_tag() {
    [[ -z ${1:-} ]] || die "tag not yet supporter for veracrypt container"
}

resolve_volume_type() {
    local requested_type=${1:-auto}
    local actual_type=${2:-}
    local subject=$3
    local subject_kind=${4:-source}
    local allow_unknown_explicit=${5:-0}

    if [[ -n $actual_type ]]; then
        if [[ $requested_type != auto && $requested_type != "$actual_type" ]]; then
            die "Requested --type $requested_type but detected $actual_type container for $subject_kind: $subject"
        fi

        printf '%s\n' "$actual_type"
        return
    fi

    if [[ $requested_type != auto ]]; then
        if [[ $allow_unknown_explicit -eq 1 ]]; then
            printf '%s\n' "$requested_type"
            return
        fi

        die "Requested --type $requested_type but could not verify that $subject_kind as a $requested_type container: $subject"
    fi

    die "Unsupported or unrecognized encrypted $subject_kind: $subject"
}

mapper_name_from_device_path() {
    local device_path=$1
    local canonical_device=""
    local candidate=""

    if [[ $device_path == /dev/mapper/* ]]; then
        normalize_mapper_name "$device_path"
        return
    fi

    canonical_device=$(canonical_device_path "$device_path")
    for candidate in /dev/mapper/*; do
        [[ -e $candidate ]] || continue
        [[ $candidate == "/dev/mapper/control" ]] && continue
        if [[ $(canonical_device_path "$candidate") == "$canonical_device" ]]; then
            normalize_mapper_name "$candidate"
            return
        fi
    done

    return 1
}

active_mapper_volume_type() {
    local mapper_name=$1
    local status_output=""
    local type_name=""

    status_output=$(run_privileged cryptsetup status "$mapper_name" 2>/dev/null || true)
    type_name=$(printf '%s\n' "$status_output" | sed -n 's/^[[:space:]]*type:[[:space:]]*//p' | head -n 1)
    type_name=${type_name,,}

    case "$type_name" in
        luks* )
            printf 'luks\n'
            ;;
        tcrypt* | veracrypt* )
            printf 'veracrypt\n'
            ;;
    esac
}

mapper_name_from_dm_sysfs_path() {
    local dm_sysfs_path=$1

    [[ -r $dm_sysfs_path/dm/name ]] || return 1
    cat "$dm_sysfs_path/dm/name"
}

# Reverse-lookup active lurker mappers by their direct backing block device.
active_lurker_mappers_for_block_device() {
    local target_path=$1
    local target_device_identity=""
    local candidate_sysfs=""
    local candidate_name=""
    local candidate_slave=""
    local candidate_slave_identity=""

    target_device_identity=$(device_identity_for_path "$target_path") || return 1

    for candidate_sysfs in /sys/class/block/dm-*; do
        [[ -e $candidate_sysfs ]] || continue

        candidate_name=$(mapper_name_from_dm_sysfs_path "$candidate_sysfs") || continue
        [[ $candidate_name == lurker_* ]] || continue

        for candidate_slave in "$candidate_sysfs"/slaves/*; do
            [[ -e $candidate_slave ]] || continue

            candidate_slave_identity=$(device_identity_for_sysfs_block_path "$candidate_slave" 2>/dev/null || true)
            if [[ -n $candidate_slave_identity && $candidate_slave_identity == "$target_device_identity" ]]; then
                printf '%s\n' "$candidate_name"
                break
            fi
        done
    done
}

probe_source_volume_type() {
    local source_path=$1
    local canonical_source=""

    if is_block_device_target "$source_path"; then
        canonical_source=$(canonical_device_path "$source_path")
    else
        canonical_source=$(absolute_path "$source_path")
    fi

    if is_luks_source "$canonical_source"; then
        printf 'luks\n'
        return
    fi

    if is_veracrypt_source "$canonical_source"; then
        printf 'veracrypt\n'
    fi
}

detect_source_volume_type() {
    local source_path=$1
    local requested_type=${2:-auto}
    local actual_type=""

    actual_type=$(probe_source_volume_type "$source_path")
    resolve_volume_type "$requested_type" "$actual_type" "$source_path" "source"
}

detect_umount_volume_type() {
    local target=$1
    local requested_type=${2:-auto}
    local canonical_target=""
    local source=""
    local mapper_name=""
    local mapper_type=""
    local actual_type=""
    local allow_unknown_explicit=0
    local mountpoint=""

    if [[ $target == /dev/mapper/* ]]; then
        mapper_name=$(normalize_mapper_name "$target")
        mapper_type=$(active_mapper_volume_type "$mapper_name")
        if [[ -n $mapper_type ]]; then
            actual_type=$mapper_type
        elif have_veracrypt; then
            mountpoint=$(find_mountpoint_for_source "$target")
            if [[ -n $mountpoint ]] && veracrypt_target_is_mounted "$mountpoint"; then
                actual_type="veracrypt"
            fi
        fi

        allow_unknown_explicit=1
        if [[ $requested_type == auto && -z $actual_type ]]; then
            printf 'luks\n'
            return
        fi

        resolve_volume_type "$requested_type" "$actual_type" "$target" "target" "$allow_unknown_explicit"
        return
    fi

    if [[ -d $target ]]; then
        canonical_target=$(absolute_path "$target")
        source=$(find_mount_source_for_mountpoint "$canonical_target")
        if have_veracrypt && veracrypt_target_is_mounted "$canonical_target"; then
            actual_type="veracrypt"
        elif [[ $source == /dev/mapper/* ]]; then
            mapper_name=$(normalize_mapper_name "$source")
            mapper_type=$(active_mapper_volume_type "$mapper_name")
            if [[ -n $mapper_type ]]; then
                actual_type=$mapper_type
            fi
        fi

        allow_unknown_explicit=1
        if [[ $requested_type == auto && -z $actual_type ]]; then
            printf 'luks\n'
            return
        fi

        resolve_volume_type "$requested_type" "$actual_type" "$target" "target" "$allow_unknown_explicit"
        return
    fi

    actual_type=$(probe_source_volume_type "$target")
    resolve_volume_type "$requested_type" "$actual_type" "$target" "target"
}

veracrypt_target_is_mounted() {
    local identifier=$1

    run_privileged veracrypt -t -l "$identifier" >/dev/null 2>&1
}

resolve_veracrypt_umount_identifier() {
    local target=$1
    local canonical_target=""
    local mountpoint=""

    if [[ $target == /dev/mapper/* ]]; then
        mountpoint=$(find_mountpoint_for_source "$target")
        [[ -n $mountpoint ]] || die "VeraCrypt mapper is not mounted: $target"
        veracrypt_target_is_mounted "$mountpoint" || die "VeraCrypt mapper is not mounted: $target"
        printf '%s\n' "$mountpoint"
        return
    fi

    if [[ -d $target ]]; then
        canonical_target=$(absolute_path "$target")
        veracrypt_target_is_mounted "$canonical_target" || die "Not a mounted VeraCrypt path: $target"
        printf '%s\n' "$canonical_target"
        return
    fi

    if is_block_device_target "$target"; then
        if veracrypt_target_is_mounted "$target"; then
            printf '%s\n' "$target"
            return
        fi

        canonical_target=$(canonical_device_path "$target")
        if [[ $canonical_target != "$target" ]] && veracrypt_target_is_mounted "$canonical_target"; then
            printf '%s\n' "$canonical_target"
            return
        fi

        die "VeraCrypt source is not mounted: $target"
    fi

    require_existing_file "$target"

    if veracrypt_target_is_mounted "$target"; then
        printf '%s\n' "$target"
        return
    fi

    canonical_target=$(absolute_path "$target")
    if [[ $canonical_target != "$target" ]] && veracrypt_target_is_mounted "$canonical_target"; then
        printf '%s\n' "$canonical_target"
        return
    fi

    die "VeraCrypt source is not mounted: $target"
}

resolve_umount_target() {
    local target=$1
    local tag_override=${2:-}
    local canonical_target=""
    local source=""
    local matching_mappers=()

    resolved_target_kind=""
    resolved_mapper_name=""
    resolved_mapper_path=""
    resolved_mountpoint=""
    resolved_origin=""

    if [[ $target == /dev/mapper/* ]]; then
        warn_ignored_umount_tag "mapper"
        resolved_target_kind="mapper"
        resolved_mapper_name=$(mapper_name_from_device_path "$target") || die "Mapper is not active: $target"
        resolved_mapper_path=$(mapper_device_path "$resolved_mapper_name")
        [[ -e $resolved_mapper_path ]] || die "Mapper is not active: $target"
        resolved_mountpoint=$(find_mountpoint_for_source "$resolved_mapper_path")
        resolved_origin=$target
        return
    fi

    if [[ -d $target ]]; then
        warn_ignored_umount_tag "mountpoint"
        canonical_target=$(absolute_path "$target")
        source=$(find_mount_source_for_mountpoint "$canonical_target")
        [[ -n $source ]] || die "Not a mounted path: $target"
        resolved_mapper_name=$(mapper_name_from_device_path "$source") || die "Mounted path is not backed by a device-mapper mapper: $target"
        resolved_mapper_path=$(mapper_device_path "$resolved_mapper_name")
        resolved_mountpoint=$canonical_target
        resolved_target_kind="mountpoint"
        resolved_origin=$canonical_target
        return
    fi

    if is_block_device_target "$target"; then
        canonical_target=$(canonical_device_path "$target")

        if [[ -n $tag_override ]]; then
            resolved_mapper_name=$(mapper_name_for_source "$canonical_target" "$tag_override")
        else
            mapfile -t matching_mappers < <(active_lurker_mappers_for_block_device "$canonical_target" || true)

            if [[ ${#matching_mappers[@]} -eq 0 ]]; then
                die "Block device is not open via an active lurker mapper: $target"
            fi

            if [[ ${#matching_mappers[@]} -gt 1 ]]; then
                die "Block device matches multiple active lurker mappers: ${matching_mappers[*]}. Use a mountpoint or explicit /dev/mapper path."
            fi

            resolved_mapper_name=${matching_mappers[0]}
        fi

        resolved_mapper_path=$(mapper_device_path "$resolved_mapper_name")
        resolved_mountpoint=$(find_mountpoint_for_source "$resolved_mapper_path")

        if [[ -z $resolved_mountpoint && ! -e $resolved_mapper_path ]]; then
            if [[ -n $tag_override ]]; then
                die "Block device is not open: $target"
            fi

            die "Block device is not open via an active lurker mapper: $target"
        fi

        resolved_target_kind="block"
        resolved_origin=$canonical_target
        return
    fi

    require_existing_file "$target"
    canonical_target=$(absolute_path "$target")
    resolved_mapper_name=$(mapper_name_for_source "$canonical_target" "$tag_override")
    resolved_mapper_path=$(mapper_device_path "$resolved_mapper_name")
    resolved_mountpoint=$(find_mountpoint_for_source "$resolved_mapper_path")

    if [[ -z $resolved_mountpoint && ! -e $resolved_mapper_path ]]; then
        die "Container is not open: $target"
    fi

    resolved_target_kind="file"
    resolved_origin=$canonical_target
}

validate_size() {
    [[ $1 =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]] || die "Size must be a positive number of GB."
}

size_gb_to_mb() {
    local size_mb

    validate_size "$1"
    size_mb=$(printf 'scale=0; (%s * 1024) / 1\n' "$1" | bc)

    [[ $size_mb =~ ^[0-9]+$ ]] || die "Failed to convert size to MB."
    [[ $size_mb -gt 0 ]] || die "Size must be greater than zero."

    printf '%s\n' "$size_mb"
}

require_passphrase_tty() {
    [[ -t 0 ]] || die "This action requires an interactive TTY for the passphrase prompt."
}

require_existing_file() {
    [[ -f $1 ]] || die "File does not exist or is not a regular file: $1"
}

require_existing_directory() {
    [[ -d $1 ]] || die "Directory does not exist: $1"
}

require_existing_source() {
    source_kind=$(source_kind_for_path "$1") || die "Source does not exist or is not a regular file or block device: $1"
}

require_writable_parent_directory() {
    local parent_dir

    parent_dir=$(dirname -- "$1")
    require_existing_directory "$parent_dir"
    [[ -w $parent_dir ]] || die "Directory is not writable: $parent_dir"
}

block_device_type() {
    lsblk -ndo TYPE -- "$1" 2>/dev/null || true
}

block_device_filesystem() {
    lsblk -ndo FSTYPE -- "$1" 2>/dev/null || true
}

block_device_tree_has_mounts() {
    lsblk -nrpo MOUNTPOINT -- "$1" 2>/dev/null | grep -q '[^[:space:]]'
}

assert_create_file_target() {
    require_writable_parent_directory "$file_path"

    if [[ -e $file_path && ! -f $file_path ]]; then
        die "Target exists and is not a regular file: $file_path"
    fi

    if [[ -e $file_path && $force_overwrite -eq 0 ]]; then
        die "Target file already exists. Re-run with -F to overwrite it."
    fi
}

assert_create_block_target() {
    local device_type=""
    local existing_signature=""

    require_command lsblk

    is_block_device_target "$file_path" || die "Block device does not exist: $file_path"
    [[ $file_path != /dev/mapper/* ]] || die "Refusing to create on an active mapper device: $file_path"

    if [[ $force_overwrite -eq 0 ]]; then
        die "Block-device create is destructive. Re-run with -F to continue: $file_path"
    fi

    device_type=$(block_device_type "$file_path")
    [[ -n $device_type ]] || die "Failed to inspect block device: $file_path"

    case "$device_type" in
        disk | part | loop)
            ;;
        *)
            die "Unsupported block device type for create: $file_path (${device_type})"
            ;;
    esac

    if block_device_tree_has_mounts "$file_path"; then
        die "Block device or one of its children is mounted: $file_path"
    fi

    existing_signature=$(block_device_filesystem "$file_path")
    if [[ -n $existing_signature ]]; then
        warn "Existing on-disk signature detected on $file_path: $existing_signature"
    fi
}

assert_create_target() {
    case "$source_kind" in
        file)
            assert_create_file_target
            ;;
        block)
            assert_create_block_target
            ;;
        *)
            die "Unsupported create target kind: $source_kind"
            ;;
    esac
}

reject_removed_operand_flag() {
    case "$action" in
        create)
            die "Operand flags are no longer supported. Use: $SCRIPT_NAME create [--type TYPE] <file> <size-gb> [-F|--force], $SCRIPT_NAME create [--type TYPE] <block-device> [-F|--force], or $SCRIPT_NAME createvc ..."
            ;;
        mount)
            die "Operand flags are no longer supported. Use: $SCRIPT_NAME mount <source> <mountpoint>"
            ;;
        umount)
            die "Operand flags are no longer supported. Use: $SCRIPT_NAME umount <target>"
            ;;
        *)
            die "Unsupported argument chosen: $1"
            ;;
    esac
}

validate_args() {
    [[ -n $action ]] || {
        show_help >&2
        die "Action is required. Use: create, mount, or umount."
    }

    if [[ $action != "create" && $force_overwrite -eq 1 ]]; then
        die "Option -F is only valid with create."
    fi

    if [[ $action != "mount" && $action != "umount" && -n $mapper_tag ]]; then
        die "Option -t is only valid with mount or umount."
    fi

    if [[ $action != "create" && $action != "mount" && $action != "umount" && $volume_type_explicit -eq 1 ]]; then
        die "Option --type is only valid with create, mount, or umount."
    fi

    case "$action" in
        create)
            if [[ $volume_type == "auto" ]]; then
                if [[ $volume_type_explicit -eq 1 ]]; then
                    die "Option --type auto is not valid with create. Use luks or veracrypt."
                fi

                volume_type="luks"
            fi

            [[ ${#action_args[@]} -ge 1 && ${#action_args[@]} -le 2 ]] || die "Usage: $SCRIPT_NAME create [--type TYPE] <file> <size-gb> [-F|--force] or $SCRIPT_NAME create [--type TYPE] <block-device> [-F|--force]"
            file_path=${action_args[0]}

            if [[ -e $file_path && ! -f $file_path && ! -b $file_path ]]; then
                die "Target exists and is neither a regular file nor block device: $file_path"
            fi

            if is_block_device_target "$file_path"; then
                source_kind="block"
                [[ ${#action_args[@]} -eq 1 ]] || die "Usage: $SCRIPT_NAME create [--type TYPE] <block-device> [-F|--force]"
                file_size=""
            else
                source_kind="file"
                [[ ${#action_args[@]} -eq 2 ]] || die "Usage: $SCRIPT_NAME create [--type TYPE] <file> <size-gb> [-F|--force]"
                file_size=${action_args[1]}
            fi

            assert_create_target
            ;;
        mount)
            [[ ${#action_args[@]} -eq 2 ]] || die "Usage: $SCRIPT_NAME mount [--type TYPE] [-t tag] <source> <mountpoint>"
            file_path=${action_args[0]}
            mount_path=${action_args[1]}
            require_existing_source "$file_path"
            require_existing_directory "$mount_path"
            ;;
        umount)
            [[ ${#action_args[@]} -eq 1 ]] || die "Usage: $SCRIPT_NAME umount [--type TYPE] [-t tag] <target>"
            umount_target=${action_args[0]}
            ;;
        *)
            die "Action $action not recognized. Use: create, createvc, mount, or umount."
            ;;
    esac
}

require_commands_for_action() {
    require_command cryptsetup

    case "$action" in
        create)
            require_command mkfs.btrfs
            require_command sha256sum
            if [[ $volume_type == "veracrypt" ]]; then
                require_command veracrypt
            fi

            if [[ $source_kind == "file" ]]; then
                require_command bc
                if [[ $volume_type == "luks" ]]; then
                    require_command dd
                fi
            fi
            ;;
        mount)
            require_command mount
            require_command sha256sum
            ;;
        umount)
            require_command umount
            require_command findmnt
            require_command sha256sum
            ;;
    esac
}

should_show_progress() {
    have_command pv && [[ -t 2 ]]
}

write_container_file() {
    local filepath=$1
    local filesize_in_mb=$2

    if should_show_progress; then
        msg2 "Writing random data with progress"
        dd if=/dev/urandom bs=1M count="$filesize_in_mb" status=none \
            | pv -pterb -s "${filesize_in_mb}M" -N "fill" > "$filepath"
        return
    fi

    msg2 "Writing random data"
    dd if=/dev/urandom of="$filepath" bs=1M count="$filesize_in_mb" status=none
}

luks_format() {
    if is_block_device_target "$1"; then
        run_privileged cryptsetup -v --type luks2 -c aes-xts-plain64 -h sha512 -s 512 -i 2000 --use-urandom -y -q luksFormat "$1" >/dev/null
        return
    fi

    cryptsetup -v --type luks2 -c aes-xts-plain64 -h sha512 -s 512 -i 2000 --use-urandom -y -q luksFormat "$1" >/dev/null
}

luks_open() {
    run_privileged cryptsetup luksOpen "$1" "$2"
}

crypt_close() {
    run_privileged cryptsetup close "$1"
}

tcrypt_open() {
    run_privileged cryptsetup open --type tcrypt --veracrypt "$1" "$2"
}

veracrypt_create() {
    local source_path=$1
    local target_kind=$2
    local filesize_in_mb=${3:-}
    local -a cmd=(
        veracrypt
        -t
        --create
        --force
        --volume-type=normal
        --encryption=AES
        --hash=SHA-512
        --filesystem=none
        --random-source=/dev/urandom
        --pim=0
        -k
        ""
    )

    case "$target_kind" in
        file)
            cmd+=("--size=${filesize_in_mb}M")
            ;;
        block)
            cmd+=("--size=max" "--quick")
            ;;
        *)
            die "Unsupported VeraCrypt create target kind: $target_kind"
            ;;
    esac

    cmd+=("$source_path")

    if [[ $target_kind == "block" ]]; then
        run_privileged "${cmd[@]}"
        return
    fi

    "${cmd[@]}"
}

detect_filesystem_type() {
    local device_path=$1
    local filesystem_type=""

    if have_command blkid; then
        filesystem_type=$(run_privileged blkid -o value -s TYPE -- "$device_path" 2>/dev/null || true)
        if [[ -n $filesystem_type ]]; then
            printf '%s\n' "$filesystem_type"
            return
        fi
    fi

    if have_command lsblk; then
        filesystem_type=$(lsblk -ndo FSTYPE -- "$device_path" 2>/dev/null || true)
        if [[ -n $filesystem_type ]]; then
            printf '%s\n' "$filesystem_type"
        fi
    fi
}

mount_open_mapper() {
    local mapper_name=$1
    local mountpoint=$2
    local mapper_path
    local filesystem_type

    mapper_path=$(mapper_device_path "$mapper_name")
    filesystem_type=$(detect_filesystem_type "$mapper_path")

    if [[ -n $filesystem_type ]]; then
        msg2 "Detected filesystem: $filesystem_type"
    else
        msg2 "Filesystem type could not be detected; mounting without filesystem-specific options"
    fi

    msg2 "Mounting filesystem at $mountpoint"
    if [[ ${filesystem_type,,} == "btrfs" ]]; then
        run_privileged mount -o compress=zstd "$mapper_path" "$mountpoint"
        return
    fi

    run_privileged mount "$mapper_path" "$mountpoint"
}

luks_create_device() {
    local source_path=$1
    local target_kind=$2
    local filesize_in_gb=${3:-}
    local filesize_in_mb=""
    local mapper_name

    require_passphrase_tty
    mapper_name=$(mapper_name_for_source "$source_path")

    if [[ $target_kind == "file" ]]; then
        filesize_in_mb=$(size_gb_to_mb "$filesize_in_gb")
        msg "Creating LUKS container at $source_path"
        msg2 "Target size: ${filesize_in_gb} GB (${filesize_in_mb} MiB)"
        write_container_file "$source_path" "$filesize_in_mb"
    else
        msg "Creating LUKS volume on block device $source_path"
        msg2 "Destructive mode enabled by --force"
    fi

    msg2 "Formatting LUKS2 header"
    luks_format "$source_path"

    cleanup_mapper=$mapper_name
    msg2 "Opening mapper $(mapper_device_path "$mapper_name")"
    luks_open "$source_path" "$mapper_name"

    msg2 "Creating Btrfs filesystem"
    run_privileged mkfs.btrfs -q "$(mapper_device_path "$mapper_name")"

    msg2 "Closing mapper $(mapper_device_path "$mapper_name")"
    crypt_close "$mapper_name"
    cleanup_mapper=""

    success "Created LUKS+Btrfs volume on $source_path"
    msg2 "Mapper name: $mapper_name"
}

veracrypt_create_device() {
    local source_path=$1
    local target_kind=$2
    local filesize_in_gb=${3:-}
    local filesize_in_mb=""
    local mapper_name

    require_passphrase_tty
    mapper_name=$(mapper_name_for_source "$source_path")

    if [[ $target_kind == "file" ]]; then
        filesize_in_mb=$(size_gb_to_mb "$filesize_in_gb")
        msg "Creating VeraCrypt container at $source_path"
        msg2 "Target size: ${filesize_in_gb} GB (${filesize_in_mb} MiB)"
    else
        msg "Creating VeraCrypt volume on block device $source_path"
        msg2 "Destructive mode enabled by --force"
        msg2 "Using VeraCrypt quick format for device-hosted creation"
    fi

    msg2 "Creating VeraCrypt header (normal, password-only, AES, SHA-512, filesystem=none)"
    veracrypt_create "$source_path" "$target_kind" "$filesize_in_mb"

    cleanup_mapper=$mapper_name
    msg2 "Opening mapper $(mapper_device_path "$mapper_name") with cryptsetup"
    tcrypt_open "$source_path" "$mapper_name"

    msg2 "Creating Btrfs filesystem"
    run_privileged mkfs.btrfs -q "$(mapper_device_path "$mapper_name")"

    msg2 "Closing mapper $(mapper_device_path "$mapper_name")"
    crypt_close "$mapper_name"
    cleanup_mapper=""

    success "Created VeraCrypt+Btrfs volume on $source_path"
    msg2 "Mapper name: $mapper_name"
}

luks_mount_device() {
    local source_path=$1
    local mountpoint=$2
    local tag_override=${3:-}
    local mapper_name

    require_passphrase_tty
    mapper_name=$(mapper_name_for_source "$source_path" "$tag_override")
    cleanup_mapper=$mapper_name

    msg "Mounting source $source_path"
    msg2 "Opening mapper $(mapper_device_path "$mapper_name")"
    luks_open "$source_path" "$mapper_name"

    mount_open_mapper "$mapper_name" "$mountpoint"
    cleanup_mapper=""

    success "Mounted $source_path at $mountpoint"
    msg2 "Mapper name: $mapper_name"
}

dmcrypt_umount_device() {
    local target=$1
    local tag_override=${2:-}

    resolve_umount_target "$target" "$tag_override"

    msg "Unmounting ${resolved_target_kind} target ${resolved_origin}"
    if [[ -n $resolved_mountpoint ]]; then
        msg2 "Unmounting filesystem at ${resolved_mountpoint}"
        run_privileged umount "$resolved_mountpoint"
    else
        msg2 "No mounted filesystem detected for ${resolved_mapper_path}"
    fi

    msg2 "Closing mapper ${resolved_mapper_path}"
    crypt_close "$resolved_mapper_name"
    success "Closed mapper ${resolved_mapper_name}"
    msg2 "Resolved input kind: ${resolved_target_kind}"
}

tcrypt_mount_device() {
    local source_path=$1
    local mountpoint=$2
    local mapper_name

    require_passphrase_tty
    mapper_name=$(mapper_name_for_source "$source_path")
    cleanup_mapper=$mapper_name

    msg "Mounting VeraCrypt source $source_path"
    msg2 "Opening mapper $(mapper_device_path "$mapper_name") with cryptsetup fallback"
    tcrypt_open "$source_path" "$mapper_name"

    mount_open_mapper "$mapper_name" "$mountpoint"
    cleanup_mapper=""

    success "Mounted $source_path at $mountpoint"
    msg2 "Mapper name: $mapper_name"
}

veracrypt_mount_device() {
    local source_path=$1
    local mountpoint=$2

    require_passphrase_tty

    msg "Mounting VeraCrypt source $source_path"
    run_privileged veracrypt -t --mount -k "" --pim=0 --protect-hidden=no "$source_path" "$mountpoint"
    success "Mounted $source_path at $mountpoint"
}

veracrypt_umount_device() {
    local target=$1
    local identifier=""

    identifier=$(resolve_veracrypt_umount_identifier "$target")
    msg "Unmounting VeraCrypt target ${identifier}"
    run_privileged veracrypt -t -u "$identifier"
    success "Unmounted VeraCrypt target ${identifier}"
}

mount_device() {
    local source_path=$1
    local mountpoint=$2
    local tag_override=${3:-}
    local detected_type=""

    if [[ $volume_type == "veracrypt" ]]; then
        require_supported_veracrypt_tag "$tag_override"
    fi

    detected_type=$(detect_source_volume_type "$source_path" "$volume_type")

    case "$detected_type" in
        veracrypt)
            require_supported_veracrypt_tag "$tag_override"
            if have_veracrypt; then
                veracrypt_mount_device "$source_path" "$mountpoint"
                return
            fi

            notice_veracrypt_fallback
            tcrypt_mount_device "$source_path" "$mountpoint"
            ;;
        *)
            luks_mount_device "$source_path" "$mountpoint" "$tag_override"
            ;;
    esac
}

umount_device() {
    local target=$1
    local tag_override=${2:-}
    local detected_type=""

    if [[ $volume_type == "veracrypt" ]]; then
        require_supported_veracrypt_tag "$tag_override"
    fi

    detected_type=$(detect_umount_volume_type "$target" "$volume_type")

    case "$detected_type" in
        veracrypt)
            require_supported_veracrypt_tag "$tag_override"
            if have_veracrypt; then
                veracrypt_umount_device "$target"
                return
            fi

            notice_veracrypt_fallback
            dmcrypt_umount_device "$target" ""
            ;;
        *)
            dmcrypt_umount_device "$target" "$tag_override"
            ;;
    esac
}

parse_long_options "$@"
set -- "${PARSED_ARGS[@]}"

validate_color_mode
validate_volume_type
setup_color

if [[ $# -eq 0 ]]; then
    show_help >&2
    exit 2
fi

if [[ $1 == "-h" || $1 == "help" ]]; then
    show_help
    exit 0
fi

if [[ $1 == "-a" ]]; then
    die "The -a flag has been removed. Use: $SCRIPT_NAME <action> ..."
fi

if [[ $1 == -* ]]; then
    show_help >&2
    die "Action is required. Use: create, createvc, mount, or umount."
fi

action=$1
shift

if [[ $action == "createvc" ]]; then
    if [[ $volume_type_explicit -eq 1 && $volume_type != "veracrypt" ]]; then
        die "Action createvc only supports --type veracrypt."
    fi

    volume_type="veracrypt"
    action="create"
fi

action_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -F)
            force_overwrite=1
            shift
            ;;
        -t)
            [[ $# -ge 2 ]] || die "Option -t requires an argument."
            mapper_tag=$2
            [[ -n $mapper_tag ]] || die "Option -t requires a non-empty argument."
            shift 2
            ;;
        -h)
            shift
            show_help
            exit 0
            ;;
        -f | -m | -s)
            reject_removed_operand_flag "$1"
            ;;
        --)
            shift
            while [[ $# -gt 0 ]]; do
                action_args+=("$1")
                shift
            done
            ;;
        -*)
            show_help >&2
            die "Unsupported argument chosen: $1"
            ;;
        *)
            action_args+=("$1")
            shift
            ;;
    esac
done

validate_args
require_commands_for_action

case "$action" in
    create)
        case "$volume_type" in
            veracrypt)
                veracrypt_create_device "$file_path" "$source_kind" "$file_size"
                ;;
            *)
                luks_create_device "$file_path" "$source_kind" "$file_size"
                ;;
        esac
        ;;
    mount)
        mount_device "$file_path" "$mount_path" "$mapper_tag"
        ;;
    umount)
        umount_device "$umount_target" "$mapper_tag"
        ;;
esac

exit 0
