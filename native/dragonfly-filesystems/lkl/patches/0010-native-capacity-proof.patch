@@ -376,14 +379,32 @@
 
 static int fd_get_capacity(struct lkl_disk disk, unsigned long long *res)
 {
-	off_t off;
-
-	off = lseek(disk.fd, 0, SEEK_END);
-	if (off < 0)
-		return -1;
-
-	*res = off;
-	return 0;
+    off_t off;
+#ifdef __DragonFly__
+    struct stat st;
+    if (fstat(disk.fd, &st)) return -1;
+    unsigned long long expected;
+    if (S_ISREG(st.st_mode)) {
+        if (st.st_size <= 0 || st.st_size % 512) { errno = EINVAL; return -1; }
+        expected = st.st_size;
+    } else if (S_ISCHR(st.st_mode)) {
+        struct partinfo info;
+        if (ioctl(disk.fd, DIOCGPART, &info)) return -1;
+        if (info.media_blksize != 512 || !info.media_size ||
+            info.media_size > INT64_MAX || info.media_size % 512 ||
+            info.media_blocks != info.media_size / 512) {
+            errno = EINVAL; return -1;
+        }
+        expected = info.media_size;
+    } else { errno = EINVAL; return -1; }
+#endif
+    off = lseek(disk.fd, 0, SEEK_END);
+    if (off < 0) return -1;
+#ifdef __DragonFly__
+    if ((unsigned long long)off != expected) { errno = EINVAL; return -1; }
+#endif
+    *res = off;
+    return 0;
 }
 
