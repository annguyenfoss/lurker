+static int original_root = -1;
+
+/* Restore the namespace root so no root/cwd reference pins the disk mount. */
+static int drain_filesystem(void)
+{
+    int ret;
+    if (original_root < 0)
+        return -LKL_EBADF;
+    ret = lkl_sys_fchdir(original_root);
+    if (ret < 0) return ret;
+    ret = lkl_sys_chroot(".");
+    if (ret < 0) return ret;
+    ret = lkl_sys_chdir("/");
+    if (ret < 0) return ret;
+    ret = lkl_sys_close(original_root);
+    if (ret < 0) return ret;
+    original_root = -1;
+    lkl_sys_sync();
+    if (!lklfuse.ro) {
+        char mpoint[32];
+        unsigned int dev;
+        ret = lkl_get_virtio_blkdev(lklfuse.disk_id, lklfuse.part, &dev);
+        if (ret < 0) return ret;
+        snprintf(mpoint, sizeof(mpoint), "/mnt/%08x", dev);
+        /* Force checked journal/data drain before releasing the filesystem. */
+        ret = lkl_sys_mount(NULL, mpoint, NULL,
+                            LKL_MS_REMOUNT | LKL_MS_RDONLY, NULL);
+        if (ret < 0) return ret;
+    }
+    ret = lkl_umount_dev(lklfuse.disk_id, lklfuse.part, 0, 10000);
+    if (ret < 0) return ret;
+    if (!lklfuse.ro && fsync(lklfuse.disk.fd) != 0) {
+        fprintf(stderr, "lklfuse: final native fsync failed: %s\n", strerror(errno));
+        return -LKL_EIO;
+    }
+    return 0;
+}
