  "host_features": {
    "FUSE": 2,
    "native_timers": "nonblocking cancellation; explicit host-op callback drain after CPU/clock shutdown and before freeing guest memory",
    "native_thread_id": "pthread_getthreadid_np",
    "host_network_adapters": false,
    "syscall_hijack_library": false
  },
  "native_static_FUSE2_recipe": "../fuse2/recipe.json",
  "native_client_contract": {
    "foreground": true,
    "single_threaded": true,
    "types": [
      "btrfs",
      "xfs"
    ],
    "memory_MiB_default": 128,
    "mount_publication": "external trusted native controller after readiness pipe; requires administrator-owned target/alias ancestry",
    "mount_source": "exact protected symlink to the inherited /dev/fuse vnode",
    "kernel_mount_flags": "default_permissions|allow_other plus NOSUID|NODEV|NOEXEC",
    "cleanup": "captured FSID/source/target globally absent, checked internal drain and no sticky I/O/transport failure",
    "product_admission": false,
    "credential_failure": "Sticky poisoned state; no new filesystem requests until verified complete restoration; registered cleanup capabilities only; retain source/channel until global absence; final exit1 even after recovery."
  }
