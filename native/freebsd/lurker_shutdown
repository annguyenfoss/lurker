#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# PROVIDE: lurker_shutdown
# REQUIRE: DAEMON
# BEFORE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="lurker_shutdown"
rcvar="lurker_shutdown_enable"
start_cmd=":"
stop_cmd="lurker_shutdown_stop"
extra_commands="plan"
plan_cmd="lurker_shutdown_plan"

lurker_shutdown_trusted()
{
    local path canonical owner permissions
    path="$1"
    case "$path" in /*) ;; *) warn "Expected an absolute administrator path"; return 1 ;; esac
    canonical=$(/bin/realpath "$path") || return 1
    [ "$canonical" = "$path" ] || { warn "Administrator paths must be canonical: $path"; return 1; }
    while :; do
        [ ! -L "$path" ] || { warn "Administrator path is a symlink: $path"; return 1; }
        owner=$(/usr/bin/stat -f %u "$path") || return 1
        permissions=$(/usr/bin/stat -f %Lp "$path") || return 1
        case "$permissions" in ''|*[!0-7]*) return 1 ;; esac
        if [ "$owner" != 0 ] || [ $((0$permissions & 022)) -ne 0 ]; then
            warn "Administrator path must be root-owned and not group/world writable: $path"
            return 1
        fi
        [ "$path" = / ] && break
        path=${path%/*}
        [ -n "$path" ] || path=/
    done
}

# Read complete lines first: shell IFS whitespace splitting would collapse tabs.
lurker_shutdown_parse()
{
    local line tab
    line="$1"
    tab="$(printf '\t')"
    case "$line" in ''|\#*) return 2 ;; esac
    case "$line" in *"$tab"*) ;; *) warn "Expected exactly one tab separator"; return 1 ;; esac
    lurker_shutdown_account=${line%%"$tab"*}
    lurker_shutdown_target=${line#*"$tab"}
    case "$lurker_shutdown_target" in *"$tab"*) warn "Extra or trailing tab separator"; return 1 ;; esac
    case "$lurker_shutdown_account" in ''|-*|*[!A-Za-z0-9_.-]*) warn "Invalid shutdown account"; return 1 ;; esac
    case "$lurker_shutdown_target" in /) warn "The system root cannot be a shutdown target"; return 1 ;; /*) ;; *) warn "Shutdown mountpoints must be absolute"; return 1 ;; esac
}

lurker_shutdown_validate()
{
    local snapshot seen line parsed uid canonical found
    snapshot="$1"
    seen="$2"
    lurker_shutdown_trusted /usr/local/bin/lurker || return 1
    [ -x /usr/local/bin/lurker ] || return 1
    : > "$seen" || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        lurker_shutdown_parse "$line"
        parsed=$?
        [ "$parsed" = 2 ] && continue
        [ "$parsed" = 0 ] || return 1
        canonical=$(/bin/realpath "$lurker_shutdown_target" 2>/dev/null) || canonical="$lurker_shutdown_target"
        /usr/bin/grep -F -x -q -e "$canonical" "$seen"
        found=$?
        case "$found" in
        0) warn "Duplicate shutdown mountpoint: $lurker_shutdown_target"; return 1 ;;
        1) ;;
        *) warn "Cannot validate shutdown mountpoint inventory"; return 1 ;;
        esac
        printf '%s\n' "$canonical" >> "$seen" || return 1
        uid=$(/usr/bin/id -u "$lurker_shutdown_account") || return 1
        if [ "$uid" != 0 ]; then
            lurker_shutdown_trusted /usr/local/bin/sudo || return 1
            [ -x /usr/local/bin/sudo ] || return 1
        fi
    done < "$snapshot"
}

# The subshell owns its temporary files and traps. Validation and execution read
# this same private, read-only snapshot even if the operator replaces the list.
lurker_shutdown_run()
(
    action="$1"
    lurker_shutdown_trusted "$lurker_shutdown_targets" || exit 1
    [ -f "$lurker_shutdown_targets" ] || { warn "Shutdown target list must be a regular file"; exit 1; }
    umask 077
    directory=$(/usr/bin/mktemp -d /var/run/lurker-shutdown.XXXXXXXX) || exit 1
    snapshot="$directory/targets"
    seen="$directory/seen"
    trap '/bin/rm -f "$snapshot" "$seen"; /bin/rmdir "$directory"' EXIT
    trap 'exit 1' HUP INT TERM
    /usr/bin/head -c 65537 "$lurker_shutdown_targets" > "$snapshot" || exit 1
    size=$(/usr/bin/stat -f %z "$snapshot") || exit 1
    [ "$size" -le 65536 ] || { warn "Shutdown target list exceeds 64 KiB"; exit 1; }
    /bin/chmod 400 "$snapshot" || exit 1
    lurker_shutdown_trusted "$lurker_shutdown_targets" || exit 1
    lurker_shutdown_validate "$snapshot" "$seen" || exit 1
    while IFS= read -r line || [ -n "$line" ]; do
        lurker_shutdown_parse "$line"
        parsed=$?
        [ "$parsed" = 2 ] && continue
        [ "$parsed" = 0 ] || exit 1
        if [ "$action" = plan ]; then
            printf '%s\t%s\n' "$lurker_shutdown_account" "$lurker_shutdown_target"
            continue
        fi
        uid=$(/usr/bin/id -u "$lurker_shutdown_account") || exit 1
        if [ "$uid" = 0 ]; then
            /usr/local/bin/lurker unmount --type auto --color=never "$lurker_shutdown_target" || exit 1
        else
            /usr/local/bin/sudo -n -u "$lurker_shutdown_account" -- /usr/local/bin/lurker unmount --type auto --color=never "$lurker_shutdown_target" || exit 1
        fi
    done < "$snapshot"
)

lurker_shutdown_plan()
{
    lurker_shutdown_run plan
}

lurker_shutdown_stop()
{
    lurker_shutdown_run stop
}

load_rc_config "$name"
: ${lurker_shutdown_enable:=NO}
: ${lurker_shutdown_targets:=/usr/local/etc/lurker/shutdown-targets}
run_rc_command "$1"
