+#define REQUEST_GROUP_LIMIT 1024
+static int reset_request_credentials(void)
+{
+	int bad = 0;
+	unsigned int uid, euid, suid, gid, egid, sgid;
+	/* Attempt every field even after a failure. Saved zero exists only inside
+	 * LKL; never change host credentials or terminate an attached channel. */
+	if (lkl_sys_setresuid(0, 0, 0) < 0)
+		bad = 1;
+	if (lkl_sys_setresgid(0, 0, 0) < 0)
+		bad = 1;
+	if (lkl_sys_setgroups(0, NULL) < 0)
+		bad = 1;
+	lkl_sys_setfsuid(0);
+	lkl_sys_setfsgid(0);
+	lkl_sys_umask(0);
+	if (lkl_sys_getresuid(&uid, &euid, &suid) < 0 || uid || euid || suid)
+		bad = 1;
+	if (lkl_sys_getresgid(&gid, &egid, &sgid) < 0 || gid || egid || sgid)
+		bad = 1;
+	if (lkl_sys_getgroups(0, NULL) != 0)
+		bad = 1;
+	if (lkl_sys_setfsuid((unsigned int)-1) != 0)
+		bad = 1;
+	if (lkl_sys_setfsgid((unsigned int)-1) != 0)
+		bad = 1;
+	if (lkl_sys_umask(0) != 0)
+		bad = 1;
+	if (bad) {
+		credential_poison = 1;
+		fprintf(stderr, "emulated credential restoration failed; service retained, requests poisoned\n");
+	}
+	return bad ? -LKL_EIO : 0;
+}
