+static int native_request_groups(const struct fuse_context *ctx, gid_t *groups)
+{
+	struct kinfo_proc before, after;
+	gid_t checked_groups[REQUEST_GROUP_LIMIT];
+	int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, ctx->pid };
+	size_t length = sizeof(before);
+	size_t group_bytes = REQUEST_GROUP_LIMIT * sizeof(*groups);
+	size_t checked_bytes = sizeof(checked_groups);
+	if (ctx->pid <= 0)
+		return -EACCES;
+	memset(&before, 0, sizeof(before));
+	memset(&after, 0, sizeof(after));
+	if (sysctl(mib, 4, &before, &length, NULL, 0) < 0 ||
+	    length != sizeof(before) || before.ki_uid != ctx->uid ||
+	    before.ki_ngroups < 1 || before.ki_groups[0] != ctx->gid)
+		return -EACCES;
+	mib[2] = KERN_PROC_GROUPS;
+	if (sysctl(mib, 4, groups, &group_bytes, NULL, 0) < 0 ||
+	    group_bytes % sizeof(*groups) || group_bytes > REQUEST_GROUP_LIMIT * sizeof(*groups))
+		return -EACCES;
+	if (sysctl(mib, 4, checked_groups, &checked_bytes, NULL, 0) < 0 ||
+	    checked_bytes != group_bytes || memcmp(groups, checked_groups, group_bytes))
+		return -EACCES;
+	mib[2] = KERN_PROC_PID;
+	length = sizeof(after);
+	if (sysctl(mib, 4, &after, &length, NULL, 0) < 0 ||
+	    length != sizeof(after) || after.ki_uid != before.ki_uid ||
+	    after.ki_ngroups != before.ki_ngroups ||
+	    memcmp(&after.ki_start, &before.ki_start, sizeof(before.ki_start)) ||
+	    memcmp(after.ki_groups, before.ki_groups, sizeof(before.ki_groups)))
+		return -EACCES;
+	/* KERN_PROC_GROUPS prefixes the effective gid to getgroups()'s vector. */
+	if (group_bytes < sizeof(*groups) || groups[0] != ctx->gid)
+		return -EACCES;
+	group_bytes -= sizeof(*groups);
+	memmove(groups, groups + 1, group_bytes);
+	return group_bytes / sizeof(*groups);
+}
+
+static int begin_request(void)
+{
+	const struct fuse_context *ctx = fuse_get_context();
+	gid_t native_groups[REQUEST_GROUP_LIMIT];
+	unsigned int groups[REQUEST_GROUP_LIMIT];
+	int count, i, ret;
+	if (credential_poison || reset_request_credentials() < 0)
+		return -EIO;
+	if (!ctx)
+		return -EACCES;
+	count = native_request_groups(ctx, native_groups);
+	if (count < 0)
+		return count;
+	for (i = 0; i < count; i++)
+		groups[i] = native_groups[i];
+	ret = lkl_sys_setgroups(count, groups);
+	if (ret >= 0)
+		ret = lkl_sys_setresgid(ctx->gid, ctx->gid, 0);
+	if (ret >= 0)
+		ret = lkl_sys_setresuid(ctx->uid, ctx->uid, 0);
+	if (ret >= 0) {
+		lkl_sys_setfsuid(ctx->uid);
+		lkl_sys_setfsgid(ctx->gid);
+		lkl_sys_umask(ctx->umask);
+		if (lkl_sys_setfsuid((unsigned int)-1) != ctx->uid ||
+		    lkl_sys_setfsgid((unsigned int)-1) != ctx->gid)
+			ret = -LKL_EPERM;
+	}
+	if (ret < 0) {
+		reset_request_credentials();
+		return host_error(ret, 0);
+	}
+	return 0;
+}
