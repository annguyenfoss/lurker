+/* A GEOM provider is a character device: fsync alone does not request
+ * its native cache flush. Do not suppress unsupported or failed ioctls. */
+int lkl_host_disk_flush(struct lkl_disk disk)
+{
+#ifdef __FreeBSD__
+	struct stat st;
+	if (fstat(disk.fd, &st) < 0)
+		return -1;
+	if (S_ISCHR(st.st_mode))
+		return ioctl(disk.fd, DIOCGFLUSH);
+	if (!S_ISREG(st.st_mode)) {
+		errno = EINVAL;
+		return -1;
+	}
+#endif
+	return fsync(disk.fd);
+}
