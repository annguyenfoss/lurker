+static int drain_filesystem(void)
+{
+	int ret;
+	/* Return to the LKL namespace root before unmounting its filesystem. */
+	lkl_sys_setresuid(-1, 0, -1);
+	lkl_sys_setresgid(-1, 0, -1);
+	if (original_root < 0)
+		return -LKL_EBADF;
+	ret = lkl_sys_fchdir(original_root);
+	if (ret < 0)
+		return ret;
+	ret = lkl_sys_chroot(".");
+	if (ret < 0)
+		return ret;
+	lkl_sys_chdir("/");
+	lkl_sys_close(original_root);
+	original_root = -1;
+	lkl_sys_sync();
+	/* Remount read-only to drain journal state before releasing the mount. */
+	char mpoint[32];
+	unsigned int dev;
+	ret = lkl_get_virtio_blkdev(lklfuse.disk_id, lklfuse.part, &dev);
+	if (ret < 0)
+		return ret;
+	snprintf(mpoint, sizeof(mpoint), "/mnt/%08x", dev);
+	ret = lkl_sys_mount(NULL, mpoint, NULL, LKL_MS_REMOUNT | LKL_MS_RDONLY, NULL);
+	if (ret < 0)
+		return ret;
+	ret = lkl_umount_dev(lklfuse.disk_id, lklfuse.part, 0, 10000);
+	if (ret < 0)
+		return ret;
+	return fsync(lklfuse.disk.fd) == 0 ? 0 : -LKL_EIO;
+}
+
+static int write_acknowledgement(const char *name, const char *message)
+{
+	const char *path = getenv(name);
+	if (!path)
+		return 0;
+	int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return -1;
+	size_t length = strlen(message);
+	int ok = write(fd, message, length) == (ssize_t)length && fsync(fd) == 0;
+	close(fd);
+	return ok ? 0 : -1;
+}
