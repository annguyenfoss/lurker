+				// Userspace image adapter: filesystem tools issue sub-sector writes to files.
+				static Mutex rawWriteMutex;
+				ScopeLock rawWriteLock (rawWriteMutex);
+				const uint64 sectorSize = FuseService::GetVolumeSectorSize();
+				const uint64 volumeSize = FuseService::GetVolumeSize();
+				if (offset < 0 || (uint64)offset > volumeSize || size > volumeSize - (uint64)offset)
+					return -EINVAL;
+				if (offset % sectorSize || size % sectorSize)
+				{
+					const uint64 first = offset - offset % sectorSize;
+					const uint64 end = ((offset + size + sectorSize - 1) / sectorSize) * sectorSize;
+					Buffer aligned (end - first);
+					FuseService::ReadVolumeSectors (aligned, first);
+					aligned.GetRange (offset - first, size).CopyFrom (ConstBufferPtr ((const uint8 *)buf, size));
+					FuseService::WriteVolumeSectors (aligned, first);
+				}
+				else
+					FuseService::WriteVolumeSectors (BufferPtr ((uint8 *) buf, size), offset);
 				return size;
