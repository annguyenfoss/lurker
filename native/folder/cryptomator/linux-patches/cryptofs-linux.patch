+package org.cryptomator.cryptofs.fh;
+
+import java.io.IOException;
+import java.lang.foreign.*;
+import java.lang.invoke.MethodHandle;
+import java.lang.invoke.VarHandle;
+import java.nio.file.*;
+
+/** Supported FFM calls with errno captured before any further native call. */
+final class NativeStorage {
+    private static final Linker LINKER = Linker.nativeLinker();
+    private static final VarHandle ERRNO = Linker.Option.captureStateLayout().varHandle(
+        MemoryLayout.PathElement.groupElement("errno"));
+    private static MethodHandle function(String name, FunctionDescriptor signature) {
+        return LINKER.downcallHandle(LINKER.defaultLookup().find(name).orElseThrow(), signature,
+            Linker.Option.captureCallState("errno"));
+    }
+    private static final MethodHandle WRITE = function("pwrite",
+        FunctionDescriptor.of(ValueLayout.JAVA_LONG, ValueLayout.JAVA_INT, ValueLayout.ADDRESS,
+            ValueLayout.JAVA_LONG, ValueLayout.JAVA_LONG));
+    private static final MethodHandle FSYNC =
+        function("fsync", FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.JAVA_INT));
+    private static final MethodHandle FDATASYNC =
+        function("fdatasync", FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.JAVA_INT));
+    private static final MethodHandle TRUNCATE = function("ftruncate",
+        FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.JAVA_INT, ValueLayout.JAVA_LONG));
+    private static final MethodHandle MKDIR = function("mkdir",
+        FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.ADDRESS, ValueLayout.JAVA_INT));
+    private static final int AT_FDCWD = -100;
+    private static final int RENAME_NOREPLACE = 1;
+    private static final MethodHandle RENAME = function("renameat2",
+        FunctionDescriptor.of(ValueLayout.JAVA_INT, ValueLayout.JAVA_INT, ValueLayout.ADDRESS,
+            ValueLayout.JAVA_INT, ValueLayout.ADDRESS, ValueLayout.JAVA_INT));
+
+    static void verifyRuntime() {
+        // Calling this method initializes and links every required native symbol.
+    }
+
+    private static LinuxCiphertextChannel.NativeIOException failure(
+        MemorySegment state, String operation) {
+        return new LinuxCiphertextChannel.NativeIOException(
+            Path.of("<owned-ciphertext>"), operation, (int) ERRNO.get(state, 0L));
+    }
+    private static IOException invocation(Throwable failure) {
+        if (failure instanceof IOException io)
+            return io;
+        if (failure instanceof RuntimeException runtime)
+            throw runtime;
+        if (failure instanceof Error error)
+            throw error;
+        return new IOException("Native storage invocation failed", failure);
+    }
+    static int write(int fd, java.nio.ByteBuffer source, long position) throws IOException {
+        if (!source.hasRemaining())
+            return 0;
+        int size = Math.min(source.remaining(), 65536);
+        try (Arena arena = Arena.ofConfined()) {
+            MemorySegment state = arena.allocate(Linker.Option.captureStateLayout());
+            MemorySegment buffer = arena.allocate(size);
+            MemorySegment.copy(MemorySegment.ofBuffer(source), 0, buffer, 0, size);
+            long result = (long) WRITE.invokeExact(state, fd, buffer, (long) size, position);
+            if (result < 0)
+                throw failure(state, "pwrite");
+            if (result > size)
+                throw new IOException("Native write exceeded requested size");
+            source.position(source.position() + (int) result);
+            return (int) result;
+        } catch (Throwable failure) {
+            throw invocation(failure);
+        }
+    }
+    static void force(int fd, boolean metadata) throws IOException {
+        try (Arena arena = Arena.ofConfined()) {
+            MemorySegment state = arena.allocate(Linker.Option.captureStateLayout());
+            int result = metadata ? (int) FSYNC.invokeExact(state, fd)
+                                  : (int) FDATASYNC.invokeExact(state, fd);
+            if (result != 0)
+                throw failure(state, metadata ? "fsync" : "fdatasync");
+        } catch (Throwable failure) {
+            throw invocation(failure);
+        }
+    }
+    static void truncate(int fd, long length) throws IOException {
+        try (Arena arena = Arena.ofConfined()) {
+            MemorySegment state = arena.allocate(Linker.Option.captureStateLayout());
+            int result = (int) TRUNCATE.invokeExact(state, fd, length);
+            if (result != 0)
+                throw failure(state, "ftruncate");
+        } catch (Throwable failure) {
+            throw invocation(failure);
+        }
+    }
+    static void createPrivateDirectory(Path path) throws IOException {
+        try (Arena arena = Arena.ofConfined()) {
+            MemorySegment state = arena.allocate(Linker.Option.captureStateLayout());
+            int result = (int) MKDIR.invokeExact(state, arena.allocateFrom(path.toString()), 0700);
+            if (result != 0) {
+                int error = (int) ERRNO.get(state, 0L);
+                if (error == 17)
+                    throw new FileAlreadyExistsException(path.toString());
+                throw failure(state, "mkdir");
+            }
+        } catch (Throwable failure) {
+            throw invocation(failure);
+        }
+    }
+    static void publishNoReplace(Path draft, Path destination) throws IOException {
+        try (Arena arena = Arena.ofConfined()) {
+            MemorySegment state = arena.allocate(Linker.Option.captureStateLayout());
+            int result = (int) RENAME.invokeExact(state, AT_FDCWD, arena.allocateFrom(draft.toString()),
+                AT_FDCWD, arena.allocateFrom(destination.toString()), RENAME_NOREPLACE);
+            if (result != 0) {
+                int error = (int) ERRNO.get(state, 0L);
+                if (error == 17)
+                    throw new FileAlreadyExistsException(destination.toString());
+                throw failure(state, "renameat2");
+            }
+        } catch (Throwable failure) {
+            throw invocation(failure);
+        }
+    }
+}
