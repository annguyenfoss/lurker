--- /dev/null
+++ b/org/cryptomator/frontend/fuse/StorageErrors.java
@@ -0,0 +1,33 @@
+package org.cryptomator.frontend.fuse;
+
+import org.cryptomator.cryptofs.fh.LinuxCiphertextChannel.NativeIOException;
+import java.util.ArrayDeque;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+
+/** Preserve storage failures supplied by the Linux native I/O boundary. */
+final class StorageErrors {
+    private StorageErrors() {}
+
+    static int code(Throwable error, int fallback) {
+        var pending = new ArrayDeque<Throwable>();
+        Set<Throwable> visited = Collections.newSetFromMap(new IdentityHashMap<>());
+        pending.add(error);
+        for (int examined = 0; examined < 64 && !pending.isEmpty(); examined++) {
+            Throwable current = pending.removeFirst();
+            if (!visited.add(current)) continue;
+            if (current instanceof NativeIOException nativeError) {
+                int value = nativeError.errno();
+                if (value == 28 || value == 122) return -value;
+            }
+            Throwable cause = current.getCause();
+            if (cause != null) pending.addLast(cause);
+            for (Throwable suppressed : current.getSuppressed()) {
+                if (pending.size() == 64) break;
+                pending.addLast(suppressed);
+            }
+        }
+        return fallback;
+    }
+}
