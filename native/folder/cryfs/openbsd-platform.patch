+++ b/src/fspp/fuse/OpenBSDPrivilege.h
@@ -0,0 +1,43 @@
+// OpenBSD base FUSE requires root only while acquiring the native mount.
+#pragma once
+#if defined(__OpenBSD__)
+#include <unistd.h>
+#include <cerrno>
+#include <climits>
+#include <cstdlib>
+#include <cstring>
+
+namespace fspp { namespace fuse { namespace openbsd {
+inline bool enabled() { return std::getenv("LURKER_CRYFS_UNVEIL_PROTOCOL") != nullptr; }
+inline bool callerNumber(const char *name, unsigned int *out) {
+    const char *value = std::getenv(name);
+    if (!value || !*value) return false;
+    for (const char *p = value; *p; ++p) if (*p < '0' || *p > '9') return false;
+    errno = 0; char *end = nullptr; const unsigned long n = std::strtoul(value, &end, 10);
+    if (errno || !end || *end || n > UINT_MAX) return false;
+    *out = static_cast<unsigned int>(n); return true;
+}
+inline bool identity(unsigned int *uid, unsigned int *gid) {
+    return callerNumber("LURKER_CRYFS_CALLER_UID", uid) && callerNumber("LURKER_CRYFS_CALLER_GID", gid);
+}
+inline bool enterCaller() {
+    if (!enabled()) return true;
+    unsigned int uid, gid;
+    if (!identity(&uid, &gid)) return false;
+    // Retain saved root only until the bounded, unveiled mount acquisition.
+    return setgroups(0, nullptr) == 0 && setresgid(gid, gid, 0) == 0 && setresuid(uid, uid, 0) == 0;
+}
+inline bool enterMount() {
+    return !enabled() || (setresuid(0, 0, 0) == 0 && setresgid(0, 0, 0) == 0);
+}
+inline bool permanentCaller() {
+    if (!enabled()) return true;
+    unsigned int uid, gid;
+    if (!identity(&uid, &gid)) return false;
+    if (geteuid() == 0) { if (setgroups(0, nullptr)) return false; }
+    else if (getgroups(0, nullptr) != 0) return false;
+    return setresgid(gid, gid, gid) == 0 && setresuid(uid, uid, uid) == 0
+        && getuid() == uid && geteuid() == uid && getgid() == gid && getegid() == gid;
+}
+}}}
+#endif
