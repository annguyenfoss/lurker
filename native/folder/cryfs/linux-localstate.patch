new file mode 100644
index 0000000..57a7131
--- /dev/null
+++ b/src/cpp-utils/io/DurableFile.h
@@ -0,0 +1,100 @@
+#pragma once
+
+#include <boost/filesystem.hpp>
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <fcntl.h>
+#include <limits>
+#include <system_error>
+#include <unistd.h>
+#include <vector>
+
+namespace cpputils {
+
+namespace durablefile {
+
+enum class Publication { Replace, NewFile };
+
+class Descriptor final {
+public:
+    explicit Descriptor(int fd, const char* operation) : fd(fd) {
+        if (fd < 0) throw std::system_error(errno, std::generic_category(), operation);
+    }
+    ~Descriptor() { ::close(fd); }
+    Descriptor(const Descriptor&) = delete;
+    Descriptor& operator=(const Descriptor&) = delete;
+
+    void sync() const {
+        int result;
+        do { result = ::fsync(fd); } while (result < 0 && errno == EINTR);
+        if (result < 0) throw std::system_error(errno, std::generic_category(), "sync CryFS state");
+    }
+
+    const int fd;
+};
+
+inline void syncDirectory(const boost::filesystem::path& directory) {
+    Descriptor(::open(directory.empty() ? "." : directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC),
+               "open CryFS state directory").sync();
+}
+
+inline void createDirectories(const boost::filesystem::path& directory) {
+    if (boost::filesystem::is_directory(directory)) return;
+    auto parent = directory.parent_path();
+    if (parent.empty()) parent = ".";
+    createDirectories(parent);
+    boost::filesystem::create_directory(directory);
+    syncDirectory(parent);
+}
+
+// Atomic publication keeps the previous integrity state readable after an
+// interrupted write. Sync the bytes before installing the name and sync the
+// directory before reporting success. First-time metadata keeps the winner's
+// existing client ID if two processes initialize it.
+inline bool store(const boost::filesystem::path& path, const void* data, size_t size,
+                  Publication publish = Publication::Replace) {
+    const auto pattern = (path.parent_path() / ("." + path.filename().string() + ".tmp-XXXXXX")).string();
+    std::vector<char> name(pattern.begin(), pattern.end());
+    name.push_back('\0');
+    Descriptor file(::mkostemp(name.data(), O_CLOEXEC), "create CryFS state temporary");
+    struct Temporary final {
+        const char* path;
+        ~Temporary() { if (path) ::unlink(path); }
+    } temporary{name.data()};
+
+    const auto* bytes = static_cast<const char*>(data);
+    while (size != 0) {
+        const auto count = ::write(file.fd, bytes,
+                                   std::min(size, static_cast<size_t>(std::numeric_limits<ssize_t>::max())));
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) {
+            throw std::system_error(count < 0 ? errno : EIO, std::generic_category(), "write CryFS state");
+        }
+        bytes += count;
+        size -= static_cast<size_t>(count);
+    }
+    file.sync();
+
+    if (publish == Publication::Replace) {
+        if (::rename(name.data(), path.c_str()) < 0) {
+            throw std::system_error(errno, std::generic_category(), "replace CryFS state");
+        }
+    } else {
+        if (::link(name.data(), path.c_str()) < 0) {
+            if (errno == EEXIST) return false;
+            throw std::system_error(errno, std::generic_category(), "publish CryFS state");
+        }
+        if (::unlink(name.data()) < 0) {
+            throw std::system_error(errno, std::generic_category(), "remove CryFS state temporary");
+        }
+    }
+    temporary.path = nullptr;
+    syncDirectory(path.parent_path());
+    return true;
+}
+
+} // namespace durablefile
+
+} // namespace cpputils
