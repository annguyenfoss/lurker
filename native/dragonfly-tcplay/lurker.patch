--- a/lib/libtcplay/io.c
+++ b/lib/libtcplay/io.c
@@ -57,0 +58,26 @@
+	/* Lurker supplies exactly one binary keyfile over the inherited pipe. */
+	if (offset == 0 && strcmp(file, "/dev/stdin") == 0) {
+		size_t used = 0;
+
+		if ((mem = alloc_safe_mem(*sz)) == NULL)
+			return NULL;
+		while (used < *sz) {
+			r = read(STDIN_FILENO, (char *)mem + used, *sz - used);
+			if (r == 0)
+				break;
+			if (r < 0 && errno == EINTR)
+				continue;
+			if (r < 0)
+				goto m_err_stdin;
+			used += r;
+		}
+		if (used == 0)
+			goto m_err_stdin;
+		*sz = used;
+		return mem;
+
+	m_err_stdin:
+		free_safe_mem(mem);
+		return NULL;
+	}
+
