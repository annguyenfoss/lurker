@@ -99,0 +100,5 @@
+	/* Check the VeraCrypt header fields before converting their byte order. */
+	if (memcmp(dhdr->tc_str, VC_SIG, sizeof(dhdr->tc_str)) == 0 &&
+	    crc32((void *)dhdr, 188) != be32toh(dhdr->crc_dhdr))
+		dhdr->tc_str[0] = '\0';
