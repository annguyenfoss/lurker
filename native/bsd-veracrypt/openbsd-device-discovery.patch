+#ifdef TC_OPENBSD
+	// Raw/block nodes and symbolic aliases identify the same native device.
+	// Preserve whole-disk partition/system-drive guards for all such paths.
+	static bool IsSameOpenBSDHostDevice (const DevicePath &hostPath, const VolumePath &candidate)
+	{
+		struct stat selected;
+		if (stat (string (candidate).c_str(), &selected) != 0
+			|| (!S_ISBLK (selected.st_mode) && !S_ISCHR (selected.st_mode)))
+			return false;
+		auto sameNode = [&selected] (const string &path)
+		{
+			struct stat node;
+			return stat (path.c_str(), &node) == 0
+				&& (selected.st_mode & S_IFMT) == (node.st_mode & S_IFMT)
+				&& selected.st_rdev == node.st_rdev;
+		};
+		string host = hostPath;
+		return sameNode (host)
+			|| (host.compare (0, 5, "/dev/") == 0 && sameNode ("/dev/r" + host.substr (5)));
+	}
+#endif
