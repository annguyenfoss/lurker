+    .utimens = native_utimens,
+    .read = native_read,
+    .write = native_write,
+    .fsync = native_fsync,
+    .statfs = native_statfs,
+    .setxattr = native_setxattr,
+    .getxattr = native_getxattr,
+    .listxattr = native_listxattr,
+    .removexattr = native_removexattr,
+    .access = native_access,
+    .readdir = native_readdir,
+    .fsyncdir = native_fsyncdir,
