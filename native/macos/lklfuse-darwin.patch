+static struct lkl_disk backing;
+static unsigned long host_flush_calls;
+static int host_io_error;
+static int sticky_shutdown_error;
+static int observed_capacity(struct lkl_disk disk, unsigned long long *size) {
+  return lkl_dev_blk_ops.get_capacity(disk, size);
+}
+static int observed_request(struct lkl_disk disk, struct lkl_blk_req *req) {
+  int rc = lkl_dev_blk_ops.request(disk, req);
+  if (rc != LKL_DEV_BLK_STATUS_OK) {
+    __atomic_store_n(&host_io_error, 1, __ATOMIC_RELEASE);
+    fprintf(stderr,
+            "HOST_IO_FAILED backing_fd=%d type=%u status=%d latched=1\n",
+            disk.fd, req->type, rc);
+  }
+  if (req->type == LKL_DEV_BLK_TYPE_FLUSH ||
+      req->type == LKL_DEV_BLK_TYPE_FLUSH_OUT) {
+    __atomic_add_fetch(&host_flush_calls, 1, __ATOMIC_RELAXED);
+    fprintf(stderr, "HOST_FLUSH backing_fd=%d status=%d\n", disk.fd, rc);
+  }
+  return rc;
+}
+static struct lkl_dev_blk_ops observed_ops = {.get_capacity = observed_capacity,
+                                              .request = observed_request};
+static int backing_disk_id = -1;
+static int backing_fd = -1, original_root = -1, mounted_root_fd = -1, fs_live,
+           disk_live, namespace_restored = 1, kernel_started;
+static char inner_mount[64], inner_device[64];
+static unsigned int inner_dev_number;
+static int normal_drain(void) {
+  if (credential_poison)
+    return -LKL_EIO;
+  if (handles)
+    return -LKL_EBUSY;
+  if (fs_live) {
+    long fd = mounted_root_fd >= 0
+                  ? mounted_root_fd
+                  : lkl_sys_open(namespace_restored ? inner_mount : "/",
+                                 LKL_O_RDONLY | LKL_O_DIRECTORY, 0);
+    if (fd < 0)
+      return (int)fd;
+    long sync = lkl_sys_syncfs(fd);
+    if (sync < 0) {
+      mounted_root_fd = (int)fd;
+      fprintf(stderr, "DRAIN_LKL_SYNCFS raw=%ld close=retained\n", sync);
+      return (int)sync;
+    }
+    long close = lkl_sys_close(fd);
+    mounted_root_fd = -1;
+    fprintf(stderr, "DRAIN_LKL_SYNCFS raw=%ld close=%ld\n", sync, close);
+    if (close < 0)
+      return (int)close;
+    if (!namespace_restored) {
+      long rc = lkl_sys_fchdir(original_root);
+      if (rc < 0)
+        return (int)rc;
+      rc = lkl_sys_chroot(".");
+      if (rc < 0)
+        return (int)rc;
+      rc = lkl_sys_chdir("/");
+      if (rc < 0)
+        return (int)rc;
+      namespace_restored = 1;
+    }
+    long rc = lkl_umount_dev(backing.dev ? backing_disk_id : -1, 0, 0, 2000);
+    fprintf(stderr, "DRAIN_LKL_UMOUNT raw=%ld\n", rc);
+    if (rc < 0)
+      return (int)rc;
+    fs_live = 0;
+  }
+  if (disk_live) {
+    if (inner_device[0]) {
+      long node =
+          lkl_sys_mknod(inner_device, LKL_S_IFBLK | 0600, inner_dev_number);
+      if (node < 0 && node != -LKL_EEXIST)
+        return (int)node;
+    }
+    int released = 0;
+    struct __lkl__kernel_timespec pause = {.tv_sec = 0, .tv_nsec = 1000000};
+    for (int i = 0; inner_device[0] && i < 2000; i++) {
+      long fd = lkl_sys_open(inner_device, LKL_O_RDONLY | LKL_O_EXCL, 0);
+      if (fd >= 0) {
+        long closed = lkl_sys_close(fd);
+        if (closed < 0)
+          return (int)closed;
+        released = 1;
+        break;
+      }
+      if (fd != -LKL_EBUSY)
+        return (int)fd;
+      long paused = lkl_sys_nanosleep(&pause, NULL);
+      if (paused < 0 && paused != -LKL_EINTR)
+        return (int)paused;
+    }
+    if (inner_device[0] && !released)
+      return -LKL_EBUSY;
+    if (fsync(backing_fd) < 0) {
+      fprintf(stderr, "DRAIN_HOST_FSYNC errno=%d\n", errno);
+      return -LKL_EIO;
+    }
+    fprintf(stderr, "DRAIN_HOST_FSYNC rc=0\n");
+    long rc = lkl_disk_remove(backing);
+    fprintf(stderr, "DRAIN_DISK_REMOVE raw=%ld\n", rc);
+    if (rc < 0)
+      return (int)rc;
+    disk_live = 0;
+  }
+  return 0;
+}
+static void retain_until_normal_drain(void) {
+  unsigned tries = 0;
+  for (;;) {
+    int locked = pthread_mutex_lock(&request_lock);
+    if (locked) {
+      lgw_fail(locked);
+      sleep(1);
+      continue;
+    }
+    int raw = normal_drain();
+    int unlocked = pthread_mutex_unlock(&request_lock);
+    if (unlocked)
+      lgw_fail(unlocked);
+    if (!raw) {
+      lgw_complete(LFG_C_FILESYSTEM_SYNC | LFG_C_INNER_UNMOUNT |
+                   LFG_C_BACKEND_RELEASE_OK);
+      fprintf(
+          stderr,
+          "NORMAL_DRAIN completed; backing still open until checked cleanup\n");
+      return;
+    }
+    if (raw != -LKL_EBUSY)
+      lgw_fail(host_errno(-raw)); /* raw Linux errno translated once */
+    if (tries++ == 0 || tries % 30 == 0)
+      fprintf(stderr,
+              "DRAIN_FAILED raw=%d host=%d retained_pid=%d backing_fd=%d "
+              "handles=%s\n",
+              raw, host_errno(-raw), getpid(), backing_fd,
+              handles ? "yes" : "no");
+    sleep(1);
+  }
+}
+/* A negative halt returns before CPU/thread shutdown in the pinned LKL API.
+ * Keep the backing/claim and avoid lkl_cleanup until the API reports zero.
+ * A later successful retry never erases the original failure. */
+static void retain_until_checked_halt(void) {
+  unsigned tries = 0;
+  for (;;) {
+    long raw = lkl_sys_halt();
+    if (raw == 0) {
+      fprintf(stderr, "LKL_HALT raw=0 prior_failure=%d\n",
+              sticky_shutdown_error);
+      lgw_complete(LFG_C_HALT);
+      return;
+    }
+    sticky_shutdown_error = 1;
+    lgw_fail(raw < 0 ? host_errno((int)-raw) : EIO);
+    if (tries++ == 0 || tries % 30 == 0)
+      fprintf(stderr,
+              "LKL_HALT_FAILED raw=%ld retained_pid=%d backing_fd=%d "
+              "cleanup_deferred=1\n",
+              raw, getpid(), backing_fd);
+    sleep(1);
+  }
+}
+static int check_empty_mountpoint(const char *path) {
+  int fd = open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (fd < 0)
+    return -1;
+  struct stat st;
+  if (fstat(fd, &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() ||
+      (st.st_mode & 0022)) {
+    close(fd);
+    errno = EPERM;
+    return -1;
+  }
+  DIR *d = fdopendir(fd);
+  if (!d) {
+    close(fd);
+    return -1;
+  }
+  struct dirent *de;
+  while ((de = readdir(d)))
+    if (strcmp(de->d_name, ".") && strcmp(de->d_name, "..")) {
+      closedir(d);
+      errno = ENOTEMPTY;
+      return -1;
+    }
+  return closedir(d);
+}
+static int setup_mount(const char *type, int readonly) {
+  int rc = lkl_init(&lkl_host_ops);
+  if (rc < 0)
+    return rc;
+  rc = lkl_start_kernel("mem=128M");
+  if (rc < 0)
+    return rc;
+  kernel_started = 1;
+  struct timespec wall;
+  clock_gettime(CLOCK_REALTIME, &wall);
+  struct __lkl__kernel_timespec now = {wall.tv_sec, wall.tv_nsec};
+  lkl_sys_clock_settime(LKL_CLOCK_REALTIME, &now);
+  backing.fd = backing_fd;
+  backing.ops = &observed_ops;
+  backing_disk_id = lkl_disk_add_with_flush(&backing);
+  if (backing_disk_id < 0)
+    return backing_disk_id;
+  disk_live = 1;
+  const char *opts = readonly ? (!strcmp(type, "xfs")     ? "norecovery"
+                                 : !strcmp(type, "btrfs") ? "nologreplay"
+                                                          : "noload")
+                              : "";
+  rc = lkl_mount_dev(backing_disk_id, 0, type,
+                     LKL_MS_NOSUID | LKL_MS_NODEV |
+                         (readonly ? LKL_MS_RDONLY : 0),
+                     opts, inner_mount, sizeof inner_mount);
+  if (rc < 0)
+    return rc;
+  fs_live = 1;
+  unsigned int dev =
+      (unsigned int)strtoul(strrchr(inner_mount, '/') + 1, NULL, 16);
+  inner_dev_number = dev;
+  snprintf(inner_device, sizeof inner_device, "/dev/lurker_%08x", dev);
+  original_root = lkl_sys_open("/", LKL_O_RDONLY | LKL_O_DIRECTORY, 0);
+  if (original_root < 0)
+    return original_root;
+  mounted_root_fd =
+      lkl_sys_open(inner_mount, LKL_O_RDONLY | LKL_O_DIRECTORY, 0);
+  if (mounted_root_fd < 0)
+    return mounted_root_fd;
+  rc = lkl_sys_chdir(inner_mount);
+  if (rc < 0)
+    return rc;
+  rc = lkl_sys_chroot(".");
+  if (rc < 0)
+    return rc;
+  namespace_restored = 0;
+  rc = lkl_sys_chdir("/");
+  return rc;
+}
+
+/* Snapshot the native mount table without triggering filesystem requests. INIT
+ * must be served on the main thread before asynchronous mount completion. The
+ * observer makes no LKL calls and joins within one 10ms polling interval. */
+#include "lkl-guardian-native.h"
+static void *native_observer(void *arg) {
+  struct native_mount_watch *w = arg;
+  while (!__atomic_load_n(&w->done, __ATOMIC_ACQUIRE)) {
+    if (__atomic_load_n(&native_initialized, __ATOMIC_ACQUIRE) &&
+        !w->captured_ok) {
+      int rc = native_capture(w);
+      if (rc) {
+        w->error = rc;
+        lgw_fail(-rc); /* native errno already, never Linux-map it */
+        break;
+      }
+      if (w->captured_ok) {
+        if (!guarded_worker.active)
+          break;
+        if (lgw_ready((uint32_t)w->captured.f_fsid.val[0],
+                      (uint32_t)w->captured.f_fsid.val[1]))
+          lgw_fail(EIO);
+      }
+    }
+    if (guarded_worker.active) {
+      /* Snapshot request latches, release the credential lock before IPC. */
+      int e = pthread_mutex_lock(&request_lock);
+      if (e) {
+        lgw_fail(e);
+        break;
+      }
+      int request_error = sticky_io_error || credential_poison;
+      e = pthread_mutex_unlock(&request_lock);
+      if (e || request_error || native_signal ||
+          __atomic_load_n(&host_io_error, __ATOMIC_ACQUIRE))
+        lgw_fail(e ? e : EIO);
+    }
+    usleep(10000);
+  }
+  return NULL;
+}
+static void native_signal_handler(int signal) { native_signal = signal; }
+static sigset_t original_signal_mask;
+static int original_signal_mask_ready;
+static int native_signals(struct sigaction saved[4], int install) {
+  int signals[] = {SIGINT, SIGTERM, SIGHUP, SIGPIPE};
+  struct sigaction action = {0};
+  action.sa_handler = native_signal_handler;
+  sigemptyset(&action.sa_mask);
+  action.sa_flags = SA_RESTART;
+  if (!install && original_signal_mask_ready) {
+    int error = pthread_sigmask(SIG_SETMASK, &original_signal_mask, NULL);
+    if (error) {
+      errno = error;
+      return -1;
+    }
+  }
+  for (int i = 0; i < 4; i++)
+    if (sigaction(signals[i], install ? &action : &saved[i],
+                  install ? &saved[i] : NULL) < 0) {
+      if (install)
+        for (int j = 0; j < i; j++)
+          sigaction(signals[j], &saved[j], NULL);
+      return -1;
+    }
+  if (install) {
+    sigset_t set;
+    sigemptyset(&set);
+    for (int i = 0; i < 4; i++)
+      sigaddset(&set, signals[i]);
+    if (pthread_sigmask(SIG_UNBLOCK, &set, &original_signal_mask))
+      return -1;
+    original_signal_mask_ready = 1;
+  }
+  return 0;
+}
+/* MFMount installs dispatch signal sources while opening its channel. Rebind
+ * our async-safe disposition after INIT; keep serving until ordinary unmount.
+ */
+static int native_reassert_signals(void) {
+  int signals[] = {SIGINT, SIGTERM, SIGHUP, SIGPIPE};
+  struct sigaction action = {0};
+  action.sa_handler = native_signal_handler;
+  sigemptyset(&action.sa_mask);
+  action.sa_flags = SA_RESTART;
+  for (int i = 0; i < 4; i++)
+    if (sigaction(signals[i], &action, NULL) < 0)
+      return -1;
+  sigset_t set;
+  sigemptyset(&set);
+  for (int i = 0; i < 4; i++)
+    sigaddset(&set, signals[i]);
+  int error = pthread_sigmask(SIG_UNBLOCK, &set, NULL);
+  if (error) {
+    errno = error;
+    return -1;
+  }
+  fprintf(stderr, "NATIVE_SIGNAL_HANDLERS own=1 after_channel_init=1\n");
+  return 0;
+}
+int main(int argc, char **argv) {
+  int worker_v2 = argc > 1 && !strcmp(argv[1], "--worker-v2");
+  /* Private spawn-self entry only, never a source-path fallback. */
+  if (worker_v2 && (argc != 4 || lgw_bind(argv[3], argv[2]))) {
+    fprintf(stderr, "GUARDED_WORKER_BIND refused errno=%d\n", errno);
+    return 77;
+  }
+  int readonly = 0, allow_other = 0;
+  int first = 1;
+  for (; !worker_v2 && first < argc && argv[first][0] == '-'; first++) {
+    if (!strcmp(argv[first], "--read-only"))
+      readonly = 1;
+    else if (!strcmp(argv[first], "--allow-other"))
+      allow_other = 1;
+    else if (!strcmp(argv[first], "--version")) {
+      printf("native-lkl-macfuse candidate API35 compatibility; libfuse=%s "
+             "uid=%u\n",
+             fuse_pkgversion(), getuid());
+      return 0;
+    } else {
+      fprintf(stderr, "usage: lklfuse-darwin [--read-only] [--allow-other] "
+                      "FILE MOUNTPOINT ext4|xfs|btrfs\n");
+      return 64;
+    }
+  }
+  const char *source = worker_v2 ? NULL : (first < argc ? argv[first] : NULL);
+  const char *point = worker_v2 ? argv[2] :
+                        (first + 1 < argc ? argv[first + 1] : NULL);
+  const char *type = worker_v2 ? argv[3] :
+                       (first + 2 < argc ? argv[first + 2] : NULL);
+  if ((!worker_v2 && argc - first != 3) || !point || !type ||
+      (strcmp(type, "ext4") && strcmp(type, "xfs") && strcmp(type, "btrfs")))
+    return 64;
+  if (!getuid() || geteuid() != getuid() || getegid() != getgid()) {
+    fprintf(stderr,
+            "login-user execution required; no privileged driver path\n");
+    return 77;
+  }
+  mount_identity.identity_source = 3;
+  mount_identity.uid = getuid();
+  mount_identity.gid = getgid();
+  mount_identity.pid = getpid();
+  mode_t mask = umask(0);
+  umask(mask);
+  mount_identity.mask = mask;
+  gid_t groups[GROUP_LIMIT];
+  int ng =
+      kernel_request_groups(getpid(), getuid(), getgid(), groups, GROUP_LIMIT);
+  if (ng < 0)
+    return 1;
+  mount_identity.ngroups = ng;
+  for (int i = 0; i < ng; i++)
+    mount_identity.groups[i] = groups[i];
+  struct stat before, after;
+  if (worker_v2) {
+    backing_fd = 4; /* already exact-identity checked; never reopen the source */
+    if (fstat(backing_fd, &after) ||
+        lg_check_source(NULL, backing_fd, &guarded_worker.identity)) {
+      lgw_fail(errno);
+      return 1;
+    }
+  } else {
+    if (lstat(source, &before) || !S_ISREG(before.st_mode) ||
+        before.st_uid != getuid() || before.st_nlink != 1 ||
+        (before.st_mode & 0022)) {
+      fprintf(stderr,
+              "refuse non-owned, linked, writable-shared or nonregular backing\n");
+      return 77;
+    }
+    backing_fd = open(source, (readonly ? O_RDONLY : O_RDWR) |
+                              O_NOFOLLOW | O_CLOEXEC);
+    if (backing_fd < 0 || fstat(backing_fd, &after) ||
+        before.st_dev != after.st_dev || before.st_ino != after.st_ino) {
+      perror("backing identity");
+      return 1;
+    }
+    if (flock(backing_fd, LOCK_EX | LOCK_NB)) {
+      perror("exclusive backing claim");
+      close(backing_fd);
+      return 1;
+    }
+  }
+  char canonical_point[PATH_MAX];
+  if (!realpath(point, canonical_point)) {
+    perror("mountpoint path");
+    close(backing_fd);
+    return 1;
+  }
+  point = canonical_point;
+  if (check_empty_mountpoint(point)) {
+    perror("owned empty mountpoint");
+    close(backing_fd);
+    return 1;
+  }
+  struct native_mount_watch watch = {.point = point,
+                                     .require_writable = worker_v2};
+  if (lstat(point, &watch.underlay)) {
+    close(backing_fd);
+    return 1;
+  } /* Explicit bounded source name; no formatting needed. */
+  memcpy(watch.source, "native-lkl-", 11);
+  memcpy(watch.source + 11, type, strlen(type) + 1);
+  int rc = setup_mount(type, readonly);
+  if (rc < 0) {
+    lgw_fail(host_errno(-rc));
+    fprintf(stderr, "native LKL setup failed raw=%d host=%d\n", rc,
+            host_errno(-rc));
+    if (kernel_started) {
+      retain_until_normal_drain();
+      retain_until_checked_halt();
+      lkl_cleanup();
+    }
+    close(backing_fd);
+    return 1;
+  }
+  char opts[512];
+  snprintf(opts, sizeof opts,
+           "fsname=native-lkl-%s,volname=LKL-%s,nobrowse,local,nodev,nosuid,"
+           "noexec%s%s",
+           type, type, readonly ? ",ro" : "",
+           allow_other ? ",allow_other" : "");
+  char *av[] = {"lklfuse-darwin", "-o", opts, NULL};
+  struct fuse_args fa = FUSE_ARGS_INIT(3, av);
+  struct fuse *f = fuse_new(&fa, &native_ops, sizeof native_ops, NULL);
+
+  int signal_ready = 0, mounted = 0, observer_ready = 0;
+  pthread_t observer;
+  struct sigaction saved_signals[4];
+  if (!f) {
+    fprintf(stderr, "fuse_new failed\n");
+    rc = -1;
+    goto finish;
+  }
+  signal_ready = native_signals(saved_signals, 1) == 0;
+  if (!signal_ready) {
+    fprintf(stderr, "native signal setup failed\n");
+    rc = -1;
+    goto finish;
+  }
+  /* Create the observer before the asynchronous mount; it waits for INIT and
+   * never blocks INIT or executes emulated syscalls. */
+  if (pthread_create(&observer, NULL, native_observer, &watch)) {
+    fprintf(stderr, "native mount observer failed\n");
+    rc = -1;
+    goto finish;
+  }
+  observer_ready = 1;
+  mounted = fuse_mount(f, point) == 0;
+  if (mounted) {
+    fprintf(stderr,
+            "NATIVE_MOUNT_START pid=%d uid=%u backing_dev=%llu "
+            "backing_inode=%llu filesystem=%s\n",
+            getpid(), getuid(), (unsigned long long)after.st_dev,
+            (unsigned long long)after.st_ino, type);
+    rc = fuse_loop(f);
+  } else {
+    fprintf(stderr, "native macFUSE mount failed\n");
+    rc = -1;
+  }
+finish:
+  if (observer_ready) {
+    __atomic_store_n(&watch.done, 1, __ATOMIC_RELEASE);
+    int joined = pthread_join(observer, NULL);
+    if (joined) {
+      lgw_fail(joined);
+      fprintf(stderr, "OBSERVER_JOIN_FAILED native=%d cleanup=retained\n", joined);
+      for (;;)
+        sleep(1); /* no cleanup while observer termination is unproven */
+    }
+  }
+  /* No fuse_unmount: this macFUSE library can force an exited session. Prove
+   * the exact observed native mount is gone and the original directory remains
+   * before channel-only library cleanup, inner drain or backing release. */
+  if (mounted) {
+    unsigned tries = 0;
+    for (;;) {
+      int e = native_mount_gone(&watch);
+      if (!e)
+        break;
+      if (e != -EBUSY)
+        lgw_fail(-e);
+      if (tries++ == 0 || tries % 300 == 0)
+        fprintf(stderr,
+                "NATIVE_CLOSE_RETAIN raw=%d pid=%d captured=%d "
+                "protocol_destroy=%d\n",
+                e, getpid(), watch.captured_ok,
+                __atomic_load_n(&native_protocol_destroy, __ATOMIC_ACQUIRE));
+      usleep(10000);
+    }
+    fprintf(stderr,
+            "NATIVE_MOUNT_GONE checked_fsid=1 original_underlay=1 "
+            "protocol_destroy=%d signal=%d\n",
+            __atomic_load_n(&native_protocol_destroy, __ATOMIC_ACQUIRE),
+            native_signal);
+    if (!__atomic_load_n(&native_protocol_destroy, __ATOMIC_ACQUIRE))
+      rc = -1;
+    else
+      lgw_complete(LFG_C_NATIVE_ABSENT);
+  }
+  /* fuse_destroy may unlink libfuse hidden files through our callbacks, so it
+   * runs with the LKL filesystem alive, after the native mount identity gate.
+   * Its transitive session destruction closes only its retained MFChannel. */
+  if (f) {
+    native_library_cleanup = 1;
+    fuse_destroy(f);
+  }
+  fuse_opt_free_args(&fa);
+  retain_until_normal_drain();
+  if (original_root >= 0) {
+    long root_closed = lkl_sys_close(original_root);
+    original_root = -1; /* actual close attempted; do not retry an uncertain FD */
+    if (root_closed < 0) {
+      lgw_fail(host_errno((int)-root_closed));
+      rc = -1;
+    }
+  }
+  retain_until_checked_halt();
+  lkl_cleanup();
+  if (worker_v2) {
+    if (lg_barrier(backing_fd)) {
+      lgw_fail(errno); /* native fsync/F_FULLFSYNC error, no Linux remapping */
+      rc = -1;
+    } else
+      lgw_complete(LFG_C_BACKING_FLUSH);
+  }
+  int closed = close(backing_fd);
+  backing_fd = -1;
+  if (!closed)
+    lgw_complete(LFG_C_WORKER_BACKING_CLOSED);
+  else
+    lgw_fail(errno);
+  fprintf(stderr,
+          "BACKING_RELEASE checked_normal_drain=1 close=%d sticky_io_error=%d "
+          "host_flush_calls=%lu signal=%d host_io_error=%d halt_error=%d\n",
+          closed, sticky_io_error,
+          __atomic_load_n(&host_flush_calls, __ATOMIC_RELAXED), native_signal,
+          __atomic_load_n(&host_io_error, __ATOMIC_ACQUIRE),
+          sticky_shutdown_error);
+  if (signal_ready && native_signals(saved_signals, 0)) {
+    lgw_fail(errno);
+    rc = -1;
+  }
+  if (!credential_poison)
+    lgw_complete(LFG_C_CREDENTIALS_RESTORED);
+  if (!sticky_io_error &&
+      !__atomic_load_n(&host_io_error, __ATOMIC_ACQUIRE))
+    lgw_complete(LFG_C_NO_IO_ERROR);
+  if (!native_signal)
+    lgw_complete(LFG_C_SIGNAL_POLICY_OK); /* Mac's permanent signal-error policy */
+  int exit_code = rc != 0 || closed < 0 || sticky_io_error || native_signal ||
+                  credential_poison ||
+                  __atomic_load_n(&host_io_error, __ATOMIC_ACQUIRE) ||
+                  sticky_shutdown_error ? 1 : 0;
+  return lgw_finish(exit_code);
+
+}
