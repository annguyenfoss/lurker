+// SPDX-License-Identifier: GPL-2.0-only
+/* Native Darwin adapter derived from tools/lkl/lklfuse.c (LKL project).
+ * macFUSE 3 official vanilla callback ABI; no callback casts or bundled driver.
+ * All Linux syscall results remain raw until the outward wrapper boundary. */
+#define _DARWIN_C_SOURCE
+#define FUSE_USE_VERSION 35
+#define FUSE_DARWIN_ENABLE_EXTENSIONS 0
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <fuse3/fuse.h>
