diff --git a/libfrog/darwin.c b/libfrog/darwin.c
new file mode 100644
index 0000000..36ed515
--- /dev/null
+++ b/libfrog/darwin.c
@@ -0,0 +1,345 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Native host operations for the Darwin mkfs-only build. */
+#include <DiskArbitration/DiskArbitration.h>
+#include "platform_defs.h"
+#include "xfs.h"
+#include "libfrog/platform.h"
+#include <sys/disk.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <sys/mount.h>
+#include <sys/sysctl.h>
+
+extern char *progname;
+static int maximum_io_alignment;
+
+/* Normalize the native block/raw-device spelling without inventing an alias. */
+static const char *disk_name(const char *name)
+{
+	if (!strncmp(name, "/dev/rdisk", 10))
+		return name + 6;
+	if (!strncmp(name, "/dev/disk", 9))
+		return name + 5;
+	return NULL;
+}
+
+/* Special-device vnodes reject advisory locks in XNU. Claim the whole native
+ * disk through Disk Arbitration instead; keep the session alive until close. */
+static DASessionRef claim_session;
+static DADiskRef claim_disk;
+static bool claim_done;
+static DAReturn claim_status;
+static int claimed_fd = -1;
+
+static void claim_complete(DADiskRef disk, DADissenterRef dissenter,
+			   void *context)
+{
+	(void)disk;
+	(void)context;
+	claim_status = dissenter ? DADissenterGetStatus(dissenter) : 0;
+	claim_done = true;
+}
+static DADissenterRef refuse_claim_release(DADiskRef disk, void *context)
+{
+	(void)disk;
+	(void)context;
+	return DADissenterCreate(kCFAllocatorDefault, kDAReturnBusy,
+				 CFSTR("Native formatter holds this source"));
+}
+static void release_native_claim(void)
+{
+	if (claim_disk) {
+		if (claim_done && !claim_status)
+			DADiskUnclaim(claim_disk);
+		CFRelease(claim_disk);
+		claim_disk = NULL;
+	}
+	if (claim_session) {
+		DASessionUnscheduleFromRunLoop(claim_session,
+					       CFRunLoopGetCurrent(),
+					       kCFRunLoopDefaultMode);
+		CFRelease(claim_session);
+		claim_session = NULL;
+	}
+	claimed_fd = -1;
+}
+void platform_release_device(int fd)
+{
+	if (fd == claimed_fd)
+		release_native_claim();
+}
+static int claim_native_device(const char *path)
+{
+	DADiskRef source;
+	CFAbsoluteTime deadline;
+	const char *whole;
+	char whole_path[PATH_MAX];
+	if (claim_session) {
+		errno = EBUSY;
+		return -1;
+	}
+	claim_session = DASessionCreate(kCFAllocatorDefault);
+	if (!claim_session) {
+		errno = ENXIO;
+		return -1;
+	}
+	source =
+	    DADiskCreateFromBSDName(kCFAllocatorDefault, claim_session, path);
+	if (!source)
+		goto fail;
+	claim_disk = DADiskCopyWholeDisk(source);
+	CFRelease(source);
+	if (!claim_disk)
+		goto fail;
+	whole = DADiskGetBSDName(claim_disk);
+	if (!whole || snprintf(whole_path, sizeof(whole_path), "/dev/%s",
+			       whole) >= sizeof(whole_path))
+		goto fail;
+	if (platform_check_ismounted(whole_path, whole_path, NULL, 1))
+		goto fail;
+	claim_done = false;
+	claim_status = kDAReturnError;
+	DASessionScheduleWithRunLoop(claim_session, CFRunLoopGetCurrent(),
+				     kCFRunLoopDefaultMode);
+	DADiskClaim(claim_disk, kDADiskClaimOptionDefault, refuse_claim_release,
+		    NULL, claim_complete, NULL);
+	deadline = CFAbsoluteTimeGetCurrent() + 3.0;
+	while (!claim_done && CFAbsoluteTimeGetCurrent() < deadline)
+		CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.05, true);
+	if (!claim_done || claim_status) {
+		fprintf(stderr,
+			"%s: native disk claim refused or timed out (status "
+			"0x%x)\n",
+			progname, claim_status);
+		goto fail;
+	}
+	if (platform_check_ismounted(whole_path, whole_path, NULL, 1))
+		goto fail;
+	return 0;
+fail:
+	release_native_claim();
+	errno = EBUSY;
+	return -1;
+}
+
+int platform_check_ismounted(char *path, char *block, struct stat *known,
+			     int verbose)
+{
+	struct stat st;
+	struct statfs *mounts;
+	const char *target, *mounted;
+	int count, actual, busy = 0;
+	size_t bytes, length;
+	(void)known;
+	(void)verbose;
+	if (lstat(block, &st) < 0)
+		return 1;
+	if (S_ISREG(st.st_mode))
+		return 0; /* held-fd O_EXLOCK enforces file exclusion */
+	if (!S_ISBLK(st.st_mode) && !S_ISCHR(st.st_mode))
+		return 1;
+	target = disk_name(block);
+	if (!target)
+		return 1;
+	length = strlen(target);
+	count = getfsstat(NULL, 0, MNT_NOWAIT);
+	if (count < 0 || count > INT_MAX / (int)sizeof(*mounts) - 16)
+		return 1;
+	bytes = (size_t)(count + 16) * sizeof(*mounts);
+	mounts = calloc(1, bytes);
+	if (!mounts)
+		return 1;
+	actual = getfsstat(mounts, (int)bytes, MNT_NOWAIT);
+	if (actual < 0 || (size_t)actual >= (size_t)count + 16)
+		busy = 1;
+	else
+		for (int i = 0; i < actual; i++) {
+			mounted = disk_name(mounts[i].f_mntfromname);
+			if (mounted && !strncmp(mounted, target, length) &&
+			    (mounted[length] == '\0' ||
+			     mounted[length] == 's')) {
+				busy = 1;
+				break;
+			}
+		}
+	free(mounts);
+	if (busy)
+		fprintf(stderr,
+			"%s: mounted or indeterminate native source %s\n",
+			progname, path);
+	return busy;
+}
+int platform_check_iswritable(char *path, char *block, struct stat *st)
+{
+	return platform_check_ismounted(path, block, st, 1);
+}
+
+int platform_open_device(const char *path, int flags, bool create)
+{
+	struct stat before, held, after;
+	uint32_t writable = 0;
+	int fd, saved;
+	/* Never O_TRUNC: the claim and inode validation must precede any
+	 * writes. */
+	flags &= ~(O_TRUNC | O_EXCL | O_CREAT);
+	flags |= O_NOFOLLOW | O_CLOEXEC;
+	if (create) {
+		flags |= O_CREAT | O_EXCL | O_EXLOCK | O_NONBLOCK;
+	} else {
+		if (lstat(path, &before) < 0)
+			return -1;
+		if (S_ISREG(before.st_mode))
+			flags |= O_EXLOCK | O_NONBLOCK;
+		else if (S_ISBLK(before.st_mode) || S_ISCHR(before.st_mode)) {
+			if (claim_native_device(path) < 0)
+				return -1;
+		} else {
+			errno = EINVAL;
+			return -1;
+		}
+	}
+	fd = open(path, flags, 0600);
+	if (fd < 0) {
+		int error = errno;
+		release_native_claim();
+		errno = error;
+		return -1;
+	}
+	if (fstat(fd, &held) < 0 || lstat(path, &after) < 0)
+		goto fail;
+	if (held.st_dev != after.st_dev || held.st_ino != after.st_ino ||
+	    (!create &&
+	     (held.st_dev != before.st_dev || held.st_ino != before.st_ino))) {
+		errno = ESTALE;
+		goto fail;
+	}
+	if (S_ISREG(held.st_mode)) {
+		if (held.st_uid != getuid() || held.st_nlink != 1) {
+			errno = EPERM;
+			goto fail;
+		}
+	} else if (S_ISBLK(held.st_mode) || S_ISCHR(held.st_mode)) {
+		if (create || !disk_name(path) ||
+		    platform_check_ismounted((char *)path, (char *)path, &held,
+					     1)) {
+			errno = EBUSY;
+			goto fail;
+		}
+		if (ioctl(fd, DKIOCISWRITABLE, &writable) < 0)
+			goto fail;
+		if (!writable) {
+			errno = EROFS;
+			goto fail;
+		}
+	} else {
+		errno = EINVAL;
+		goto fail;
+	}
+	if (claim_session)
+		claimed_fd = fd;
+	return fd;
+fail:
+	saved = errno;
+	close(fd);
+	release_native_claim();
+	errno = saved;
+	return -1;
+}
+
+int platform_flush_device(int fd)
+{
+	struct stat st;
+	if (fstat(fd, &st) < 0 || fsync(fd) < 0)
+		return -1;
+	if (S_ISREG(st.st_mode))
+		return fcntl(fd, F_FULLFSYNC);
+	if (S_ISBLK(st.st_mode) || S_ISCHR(st.st_mode))
+		return ioctl(fd, DKIOCSYNCHRONIZECACHE, 0);
+	errno = EINVAL;
+	return -1;
+}
+
+void platform_findsizes(char *path, int fd, long long *size, int *blocksize)
+{
+	struct stat st;
+	uint32_t logical = 512;
+	uint64_t count, bytes;
+	if (fstat(fd, &st) < 0)
+		goto fail;
+	if (S_ISREG(st.st_mode)) {
+		if (st.st_size < 0 || st.st_size % 512) {
+			errno = EINVAL;
+			goto fail;
+		}
+		*size = st.st_size / 512;
+		*blocksize = 512;
+		return;
+	}
+	if (!S_ISBLK(st.st_mode) && !S_ISCHR(st.st_mode)) {
+		errno = EINVAL;
+		goto fail;
+	}
+	if (ioctl(fd, DKIOCGETBLOCKSIZE, &logical) < 0 ||
+	    ioctl(fd, DKIOCGETBLOCKCOUNT, &count) < 0)
+		goto fail;
+	if (logical < 512 || logical > 32768 || (logical & (logical - 1)) ||
+	    !count || count > (uint64_t)LLONG_MAX / logical) {
+		errno = EOVERFLOW;
+		goto fail;
+	}
+	bytes = count * logical;
+	if ((int)logical > maximum_io_alignment)
+		maximum_io_alignment = (int)logical;
+	if (bytes % 512) {
+		errno = EINVAL;
+		goto fail;
+	}
+	*size = (long long)(bytes / 512);
+	*blocksize = (int)logical;
+	return;
+fail:
+	fprintf(stderr, "%s: native geometry failed for %s: %s\n", progname,
+		path, strerror(errno));
+	exit(1);
+}
+void platform_set_blocksize(int fd, char *path, dev_t device, int blocksize,
+			    bool fatal)
+{
+	long long size;
+	int logical;
+	(void)device;
+	platform_findsizes(path, fd, &size, &logical);
+	if (blocksize < logical || blocksize % logical) {
+		fprintf(stderr,
+			"%s: requested block size is incompatible with native "
+			"geometry\n",
+			progname);
+		if (fatal)
+			exit(1);
+	}
+}
+int platform_direct_blockdev(void) { return 0; } /* buffered native I/O */
+int platform_align_blockdev(void)
+{
+	int page = getpagesize();
+	return maximum_io_alignment > page ? maximum_io_alignment : page;
+}
+int platform_nproc(void)
+{
+	int count;
+	size_t length = sizeof(count);
+	if (sysctlbyname("hw.ncpu", &count, &length, NULL, 0) < 0 || count < 1)
+		return 1;
+	return count;
+}
+unsigned long platform_physmem(void)
+{
+	uint64_t bytes;
+	size_t length = sizeof(bytes);
+	if (sysctlbyname("hw.memsize", &bytes, &length, NULL, 0) < 0 ||
+	    bytes / 1024 > ULONG_MAX) {
+		perror("native physical memory query");
+		exit(1);
+	}
+	return (unsigned long)(bytes / 1024);
+}
