+/* Keep XFS internal page variables distinct from native Mach macros. */
+#undef PAGE_SIZE
+#undef PAGE_SHIFT
+/* Fixed-width XFS internal/on-disk types, not a Linux host ABI. */
+typedef uint8_t __u8;
+typedef int8_t __s8;
+typedef uint16_t __u16;
+typedef int16_t __s16;
+typedef uint32_t __u32;
+typedef int32_t __s32;
+typedef uint64_t __u64;
