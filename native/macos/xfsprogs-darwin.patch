+#define __LITTLE_ENDIAN LITTLE_ENDIAN
+#define EFSCORRUPTED EILSEQ
+#define EFSBADCRC EBADMSG
+static inline void *memalign(size_t alignment, size_t length)
+{
+	void *result = NULL;
+	int error = posix_memalign(&result, alignment, length);
+	if (error) {
+		errno = error;
+		return NULL;
+	}
+	return result;
+}
+static inline int platform_uuid_compare(uuid_t *a, uuid_t *b)
+{
+	return uuid_compare(*a, *b);
+}
+static inline void platform_uuid_unparse(uuid_t *u, char *s)
+{
+	uuid_unparse(*u, s);
+}
+static inline int platform_uuid_parse(const char *s, uuid_t *u)
+{
+	return uuid_parse(s, *u);
+}
+static inline int platform_uuid_is_null(uuid_t *u) { return uuid_is_null(*u); }
+static inline void platform_uuid_generate(uuid_t *u) { uuid_generate(*u); }
+static inline void platform_uuid_clear(uuid_t *u) { uuid_clear(*u); }
+static inline void platform_uuid_copy(uuid_t *a, uuid_t *b)
+{
+	uuid_copy(*a, *b);
+}
+/* Discard is optional. Report unsupported honestly; never fake successful I/O.
+ */
+static inline int platform_discard_blocks(int fd, uint64_t start,
