diff --git a/libxfs/darwin_topology.h b/libxfs/darwin_topology.h
new file mode 100644
index 0000000..0dafe70
--- /dev/null
+++ b/libxfs/darwin_topology.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included after the unmodified portable AG geometry algorithms in topology.c.
+ */
+int check_overwrite(const char *path)
+{
+	struct stat st;
+	if (!path || !*path || lstat(path, &st) < 0)
+		return -1;
+	/* Fail closed without a native filesystem-signature scanner. -f is
+	 * explicit. */
+	return !S_ISREG(st.st_mode) || st.st_size != 0;
+}
+static void darwin_get_topology(struct libxfs_dev *dev,
+				struct device_topology *dt)
+{
+	int fd, logical;
+	long long size;
+	uint32_t physical;
+	if (!dev->name)
+		return;
+	if (dev->isfile) {
+		dt->logical_sector_size = 512;
+		dt->physical_sector_size = 512;
+		return;
+	}
+	fd = open(dev->name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) {
+		perror(dev->name);
+		exit(1);
+	}
+	platform_findsizes(dev->name, fd, &size, &logical);
+	physical = (uint32_t)logical;
+	if (ioctl(fd, DKIOCGETPHYSICALBLOCKSIZE, &physical) < 0) {
+		int error = errno;
+		close(fd);
+		errno = error;
+		perror("native physical-sector query");
+		exit(1);
+	}
+	if (physical > INT_MAX || physical < (uint32_t)logical ||
+	    physical % logical || (physical & (physical - 1))) {
+		close(fd);
+		fprintf(stderr, "Invalid native physical-sector geometry\n");
+		exit(1);
+	}
+	if (close(fd) < 0) {
+		perror("close geometry query");
+		exit(1);
+	}
+	dt->logical_sector_size = logical;
+	dt->physical_sector_size = physical;
+}
+void libxfs_get_topology(struct libxfs_init *xi, struct fs_topology *ft,
+			 bool force)
+{
+	(void)force;
+	memset(ft, 0, sizeof(*ft));
+	darwin_get_topology(&xi->data, &ft->data);
+	darwin_get_topology(&xi->log, &ft->log);
+	darwin_get_topology(&xi->rt, &ft->rt);
+}
