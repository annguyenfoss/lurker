@@ -0,0 +1,14 @@
+// Copyright 2026 Lurker contributors. GPL-2.0-or-later.
+// Native build-only integrity probe; no filesystem/image operations.
+#include <cstdint>
+#include <cstdio>
+import crc32c;
+int main() {
+    const uint8_t text[] = "123456789";
+    const auto full = calc_crc32c(0xffffffffu, text, 9);
+    const auto split = calc_crc32c(calc_crc32c(0xffffffffu, text, 4), text + 4, 5);
+    if (~full != 0xe3069283u || split != full || calc_crc32c(0x12345678u, text, 0) != 0x12345678u)
+        return 1;
+    puts("native portable CRC32C canonical/split/empty probes passed");
+    return 0;
+}
