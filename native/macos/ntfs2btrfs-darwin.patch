+#ifdef __APPLE__
+static fresh_target parse_fresh_target(string_view value) {
+    uint64_t fields[3]{};
+    for (unsigned int i = 0; i < 3; i++) {
+        auto colon = value.find(':');
+        auto field = value.substr(0, colon);
+        auto result = from_chars(field.data(), field.data() + field.size(), fields[i]);
+        if (field.empty() || result.ec != errc{} || result.ptr != field.data() + field.size() ||
+            (i < 2 && colon == string_view::npos) || (i == 2 && colon != string_view::npos))
+            throw formatted_error("Expected --fresh-format=DEVICE:INODE:BYTES in unsigned decimal.");
+        if (colon != string_view::npos)
+            value.remove_prefix(colon + 1);
+    }
+    return {fields[0], fields[1], fields[2]};
+}
