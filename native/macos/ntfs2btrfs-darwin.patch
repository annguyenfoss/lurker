+#ifdef __APPLE__
+void ntfs::flush_checked() {
+    struct stat info{};
+    if (fd < 0 || fstat(fd, &info) || !S_ISREG(info.st_mode) || info.st_nlink != 1 ||
+        info.st_uid != geteuid() || (info.st_mode & 0777) != 0600 ||
+        (uint64_t)info.st_dev != expected_identity.device ||
+        (uint64_t)info.st_ino != expected_identity.inode || info.st_size < 0 ||
+        (uint64_t)info.st_size != extent_bytes)
+        throw formatted_error("Fresh-file identity changed before synchronization.");
+    int result;
+    do { result = fsync(fd); } while (result < 0 && errno == EINTR);
+    if (result < 0)
+        throw formatted_error("Fresh-file fsync failed (errno {}).", errno);
+    do { result = fcntl(fd, F_FULLFSYNC); } while (result < 0 && errno == EINTR);
+    if (result < 0)
+        throw formatted_error("Fresh-file full media synchronization failed (errno {}).", errno);
+}
+
+void ntfs::close_checked() {
+    const int closing = descriptor.release();
+    fd = -1;
+    // Do not retry close after an error: the descriptor may already be consumed.
+    if (closing < 0 || ::close(closing))
+        throw formatted_error("Fresh-file close failed (errno {}).", closing < 0 ? 0 : errno);
+}
+
+void ntfs::require_fresh_metadata() {
+    auto bitmap = mft->read(0, 0, ntfs_attribute::BITMAP);
+    if (bitmap.size() < 4 || !(bitmap[0] & 1) || !(bitmap[0] & (1u << NTFS_ROOT_DIR_INODE)) || bitmap.size() > 8192)
+        throw formatted_error("Fresh profile rejects this nonempty/extended MFT layout.");
+    for (size_t index = 16; index < bitmap.size() * 8; index++) {
+        if (!(bitmap[index / 8] & (1u << (index % 8))))
+            continue;
+        // Fresh mkntfs reserves 0..15, and uses 24..26 for these $Extend files.
+        if (index < 24 || index > 26)
+            throw formatted_error("Fresh profile refuses allocated user-file MFT records.");
+        ntfs_file file(*this, index);
+        const auto name = file.get_filename();
+        const char* expected[] = {"\\$Extend\\$Quota", "\\$Extend\\$ObjId", "\\$Extend\\$Reparse"};
+        if (name != expected[index - 24])
+            throw formatted_error("Fresh profile refuses an unexpected NTFS metadata file.");
+    }
+}
