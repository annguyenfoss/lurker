@@ -0,0 +1,179 @@
+//go:build lurkerfuset
+
+// Copyright 2016-2026 the Go-FUSE Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package fuse
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const (
+	fuseTHelper  = "/Library/Application Support/fuse-t/bin/go-nfsv4-1.2.9"
+	mountTimeout = 20 * time.Second
+	closeTimeout = 5 * time.Second
+)
+
+func getMaxWrite() int {
+	return 1 << 20
+}
+
+// FUSE-T launch uses two local Unix sockets. The server exchanges FUSE
+// messages on fd 3 and accepts a separate native mount request on fd 4.
+func mount(point string, opts *MountOptions, ready chan<- error) (int, error) {
+	if opts.AllowOther {
+		return -1, fmt.Errorf("allow_other is unavailable in the FUSE-T experiment")
+	}
+	transport := os.Getenv("LURKER_EXPERIMENT_FUSE_T_TRANSPORT")
+	switch transport {
+	case "fskit", "smb", "nfs":
+	default:
+		return -1, fmt.Errorf("select an explicit FUSE-T transport with LURKER_EXPERIMENT_FUSE_T_TRANSPORT")
+	}
+	data, err := fuseTSocketPair()
+	if err != nil {
+		return -1, err
+	}
+	defer syscall.Close(data[0])
+	dataChild := os.NewFile(uintptr(data[1]), "fuse-t data peer")
+	defer dataChild.Close()
+
+	control, err := fuseTSocketPair()
+	if err != nil {
+		return -1, err
+	}
+	controlParent := os.NewFile(uintptr(control[0]), "fuse-t control")
+	defer controlParent.Close()
+	controlChild := os.NewFile(uintptr(control[1]), "fuse-t control peer")
+	defer controlChild.Close()
+	monitor, err := net.FileConn(controlParent)
+	if err != nil {
+		return -1, err
+	}
+
+	serverFD, err := duplicateFuseTFD(data[0])
+	if err != nil {
+		monitor.Close()
+		return -1, err
+	}
+	watchFD, err := duplicateFuseTFD(data[0])
+	if err != nil {
+		syscall.Close(serverFD)
+		monitor.Close()
+		return -1, err
+	}
+
+	args := []string{
+		"--backend", transport, "--dontbrowse=true",
+		"--volname", filepath.Base(point),
+		fmt.Sprintf("--rwsize=%d", opts.MaxWrite),
+	}
+	if opts.containsOption("ro") {
+		args = append(args, "-r")
+	}
+	args = append(args, point)
+	helper := exec.Command(fuseTHelper, args...)
+	helper.ExtraFiles = []*os.File{dataChild, controlChild}
+	helper.Env = append(os.Environ(), "_FUSE_COMMFD=3", "_FUSE_MONFD=4", "_FUSE_COMMVERS=2", "_FUSE_DAEMON_PATH="+os.Args[0])
+	helper.Stderr = os.Stderr
+	if err := helper.Start(); err != nil {
+		syscall.Close(serverFD)
+		syscall.Close(watchFD)
+		monitor.Close()
+		return -1, fmt.Errorf("launch FUSE-T: %w", err)
+	}
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		if err := helper.Wait(); err != nil {
+			opts.Logger.Printf("FUSE-T helper exited: %v", err)
+		}
+	}()
+
+	var once sync.Once
+	opts.fuseTRelease = func() {
+		once.Do(func() {
+			monitor.SetWriteDeadline(time.Now().Add(closeTimeout))
+			io.WriteString(monitor, "unmount")
+			monitor.Close()
+			select {
+			case <-done:
+			case <-time.After(closeTimeout):
+				opts.Logger.Printf("FUSE-T helper %d still running after close", helper.Process.Pid)
+			}
+		})
+	}
+
+	go func() {
+		defer close(ready)
+		defer syscall.Close(watchFD)
+		err := awaitFuseTMount(monitor)
+		if err != nil {
+			// Unblock INIT even if the helper opened but then failed to mount.
+			syscall.Shutdown(watchFD, syscall.SHUT_RDWR)
+			opts.fuseTRelease()
+			opts.Logger.Printf("FUSE-T %s: %v", transport, err)
+		}
+		ready <- err
+	}()
+	return serverFD, nil
+}
+
+func awaitFuseTMount(monitor net.Conn) error {
+	if err := monitor.SetDeadline(time.Now().Add(mountTimeout)); err != nil {
+		return err
+	}
+	if _, err := io.WriteString(monitor, "mount"); err != nil {
+		return err
+	}
+	var status [4]byte
+	if _, err := io.ReadFull(monitor, status[:]); err != nil {
+		return err
+	}
+	if errno := int32(binary.LittleEndian.Uint32(status[:])); errno != 0 {
+		return fmt.Errorf("mount helper reported status %d", errno)
+	}
+	return monitor.SetDeadline(time.Time{})
+}
+
+func fuseTSocketPair() ([2]int, error) {
+	syscall.ForkLock.RLock()
+	defer syscall.ForkLock.RUnlock()
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+	if err != nil {
+		return fds, err
+	}
+	for _, fd := range fds {
+		syscall.CloseOnExec(fd)
+		syscall.SetsockoptInt(fd, syscall.SOL_SOCKET, syscall.SO_SNDBUF, 4*1024*1024)
+		syscall.SetsockoptInt(fd, syscall.SOL_SOCKET, syscall.SO_RCVBUF, 4*1024*1024)
+	}
+	return fds, nil
+}
+
+func duplicateFuseTFD(fd int) (int, error) {
+	syscall.ForkLock.RLock()
+	defer syscall.ForkLock.RUnlock()
+	copy, err := syscall.Dup(fd)
+	if err != nil {
+		return -1, err
+	}
+	syscall.CloseOnExec(copy)
+	return copy, nil
+}
+
+func unmount(dir string, opts *MountOptions) error {
+	return syscall.Unmount(dir, 0)
+}
