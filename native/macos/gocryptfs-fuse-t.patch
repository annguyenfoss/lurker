+func (r *fuseFD) readFrame(dest []byte) (n int, err error) {
+	if r.server.opts.fuseTRelease == nil {
+		err = handleEINTR(func() error {
+			var readErr error
+			if connErr := r.withFD(func(fd int) {
+				n, readErr = syscall.Read(fd, dest)
+			}); connErr != nil {
+				return connErr
+			}
+			return readErr
+		})
+		return n, err
+	}
+	r.streamReadMu.Lock()
+	defer r.streamReadMu.Unlock()
+	return readFuseTFrame(r.file, dest)
+}
+
+func readFuseTFrame(stream io.Reader, dest []byte) (int, error) {
+	const lengthSize = 4
+	if _, err := io.ReadFull(stream, dest[:lengthSize]); err != nil {
+		if err == io.EOF {
+			return 0, syscall.ENODEV
+		}
+		return 0, syscall.EIO
+	}
+	size := int(binary.LittleEndian.Uint32(dest[:lengthSize]))
+	if size < int(unsafe.Sizeof(InHeader{})) || size > len(dest) {
+		return 0, syscall.EPROTO
+	}
+	if _, err := io.ReadFull(stream, dest[lengthSize:size]); err != nil {
+		return 0, syscall.EIO
+	}
+	return size, nil
+}
