diff --git a/tools/lkl/darwin/build.py b/tools/lkl/darwin/build.py
--- a/tools/lkl/darwin/build.py
+++ b/tools/lkl/darwin/build.py
@@ -90,11 +90,23 @@
         objects = [work / m["object"] for m in members]
         filelist = work / "objects.txt"
         filelist.write_text("\n".join(map(str, objects)) + "\n")
-        hidden = work / "hidden.txt"
-        hidden.write_text("_memcpy\n_memset\n_memmove\n")
+        # Keep kernel libc names private before native POSIX host objects are
+        # linked. A static kernel snprintf is not Darwin host libc, and may
