+/* Check native caller access, including filesystems without access(). */
+static int
+puffs_fuse_node_access(struct puffs_usermount *pu, void *opc, int mode,
+    const struct puffs_cred *cred)
+{
+	struct puffs_node *pn = opc;
+	struct fuse *fuse = puffs_getspecific(pu);
+	struct vattr va;
+	int error, mask = 0;
+
+	if (!puffs_cred_iskernel(cred) && !puffs_cred_isfs(cred) &&
+	    !puffs_cred_isuid(cred, fuse->mount_uid) && !fuse->allow_other &&
+	    !(fuse->allow_root && puffs_cred_isuid(cred, 0)))
+		return EACCES;
+	if (set_fuse_context_uid_gid(cred) != 0)
+		return EACCES;
+	set_fuse_context_pid(pu);
+	error = fuse_getattr(fuse, pn, PNPATH(pn), &va);
+	if (error)
+		return error;
+	if (mode & PUFFS_VREAD)
+		mask |= R_OK;
+	if (mode & PUFFS_VWRITE)
+		mask |= W_OK;
+	if (mode & PUFFS_VEXEC)
+		mask |= X_OK;
+	error = fuse_fs_access(fuse->fs, PNPATH(pn), mask);
+	if (error != 0 && error != -ENOSYS)
+		return -error;
+	if (error == 0 && !fuse->default_permissions)
+		return 0;
+	return puffs_access(va.va_type, va.va_mode, va.va_uid, va.va_gid,
+	    mode, cred);
