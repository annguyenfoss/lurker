+/* Diagnostic LKL bridge: forward the actual native fsync request. */
+static int
+puffs_fuse_node_fsync(struct puffs_usermount *pu, void *opc,
+    const struct puffs_cred *pcr, int flags, off_t low, off_t high)
+{
+	struct puffs_node *pn = opc;
+	struct refusenode *rn = pn->pn_data;
+	struct fuse *fuse = puffs_getspecific(pu);
+	struct fuse_file_info *fi = rn->flags & RN_OPEN ? &rn->file_info : NULL;
+	int ret;
+	(void)low;
+	(void)high;
+	if (set_fuse_context_uid_gid(pcr) != 0)
+		return EACCES;
+	if (pn->pn_va.va_type == VDIR)
+		ret = fuse_fs_fsyncdir(fuse->fs, PNPATH(pn),
+		    !!(flags & PUFFS_FSYNC_DATAONLY), fi);
+	else
+		ret = fuse_fs_fsync(fuse->fs, PNPATH(pn),
+		    !!(flags & PUFFS_FSYNC_DATAONLY), fi);
+	/* PUFFS expects a positive native errno; FUSE returns its negative. */
+	return ret > 0 ? EIO : -ret;
 }
 
