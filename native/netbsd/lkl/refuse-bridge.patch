+/* This library is scoped to the diagnostic driver, never the system SONAME. */
+unsigned int refuse_lkl_bridge_version(void) { return 2; }
+
+/* Mandatory diagnostic profile, checked before publishing any native mount. */
+int refuse_lkl_owner_only(struct fuse *fuse)
+{
+	return fuse != NULL && geteuid() != 0 && fuse->mount_uid == geteuid() &&
+	    !fuse->allow_other && !fuse->allow_root && fuse->default_permissions
+	    ? 0 : EACCES;
